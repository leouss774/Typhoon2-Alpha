# Le projet fonctionne en mode local sans clé avec les sources publiques.
DVF_ENABLED=false
COPERNICUS_ENABLED=false

# Optionnel : active les recommandations générées par Mistral.
MISTRAL_API_KEY=

# Optionnel : augmentez cette valeur si votre connexion est lente.
HTTP_TIMEOUT_SECONDS=15

# Typhoon Partner API (backend/partner_api) — clés des projets partenaires
# consommant POST /v1/analyze, format "nom:clé,nom:clé". Voir
# backend/partner_api/README.md.
PARTNER_API_KEYS=

# ══ Frontend (Vite) ══
# Un seul .env à la racine pour le front (VITE_*) et le back — Vite lit ce
# fichier via envDir: '..' dans frontend/vite.config.ts.

# Base URL de l'API backend (défaut : orchestrateur local).
VITE_API_BASE=http://127.0.0.1:8765
# Token public Mapbox (https://account.mapbox.com) — requis pour la carte.
VITE_MAPBOX_TOKEN=
# Style Mapbox (optionnel, défaut : sombre).
VITE_MAPBOX_STYLE=mapbox://styles/mapbox/standard
