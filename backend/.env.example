# ============================================================
# Variables d'environnement - orchestrateur API Typhoon
# Copier ce fichier en ".env" et completer les valeurs.
# ============================================================

# --- BDNB ---
# Aucune cle necessaire (confirme par un test reel : l'offre "Open" repond
# sans en-tete Authorization). Optionnel : renseigner une cle ici si vous
# en obtenez une plus tard pour un quota plus eleve.
BDNB_API_KEY=

# --- Georisques v1 ---
# Aucune cle necessaire (API publique, 1000 requetes/min/IP).
GEORISQUES_BASE_URL=https://www.georisques.gouv.fr/api/v1

# --- Geocodage (Base Adresse Nationale / Geoplateforme IGN) ---
# Aucune cle necessaire.
GEOCODING_URL=https://data.geopf.fr/geocodage/search

# --- IGN Altimetrie (Geoplateforme) ---
# Aucune cle necessaire.
IGN_ALTITUDE_BASE_URL=https://data.geopf.fr/altimetrie/1.0

# --- Open-Meteo Climate API ---
# Aucune cle necessaire en usage non-commercial.
OPEN_METEO_CLIMATE_URL=https://climate-api.open-meteo.com/v1/climate

# --- Copernicus Climate Data Store (remplace DRIAS) ---
# Necessite un compte + jeton personnel : voir
# docs/GUIDE_ORCHESTRATEUR_API.md section "Copernicus", et le fichier
# $HOME/.cdsapirc (pas gere via ce .env - c'est cdsapi qui le lit).
COPERNICUS_CACHE_DIR=./data/lookup/copernicus

# --- Lookup local DVF (a telecharger, voir le guide) ---
DVF_LOOKUP_DIR=./data/lookup/dvf

# --- Divers ---
HTTP_TIMEOUT_SECONDS=15
