<!-- ==================== MODALE EXPLORATION DE ZONE (carte interactive connectée au backend) ==================== -->
<div id="zone-overlay" aria-hidden="true">
  <div id="zone-modal" role="dialog" aria-modal="true" aria-labelledby="zone-modal-title">
    <button id="zone-close-btn" type="button" aria-label="Fermer la fenêtre">✕</button>
    <div id="zone-modal-header">
      <span class="modal-title" id="zone-modal-title">Carte interactive des risques</span>
      <span class="modal-sub">Sélectionnez une commune ou dessinez une zone sur la carte</span>
    </div>
    <div id="zone-modal-body">
      <!-- Sidebar -->
      <div id="zone-sidebar">
        <div id="zone-sidebar-content">
          <div class="zone-section-label">1. Choisir une ville</div>
          <div id="zone-search-wrapper">
            <input id="zone-city-input" type="text" placeholder="ex. Paris, Marseille, Lyon, Nice…" autocomplete="off" />
            <div id="zone-suggestions"></div>
          </div>
          <div id="zone-coords-info">Tapez le nom d'une ville française</div>
          <button id="zone-assess-btn" disabled>Analyser cette ville</button>

          <div id="zone-autorefine-row">
            <div>
              <label for="zone-autorefine-toggle">Affiner en zoomant</label>
              <div class="hint">Grille plus fine à chaque zoom/déplacement</div>
            </div>
            <div class="toggle-switch">
              <input type="checkbox" id="zone-autorefine-toggle" checked>
              <label class="track" for="zone-autorefine-toggle"></label>
            </div>
          </div>
          <div id="zone-refine-status"><span class="dot"></span><span id="zone-refine-status-text">Raffinement de la zone visible…</span></div>

          <div id="zone-loading">
            <div class="zone-loading-bar"><div class="zone-loading-fill"></div></div>
            <div class="zone-loading-text">Calcul en cours…</div>
          </div>

          <div id="zone-results">
            <div class="zone-section-label">3. Résultats</div>
            <div class="zone-rating-card" id="zm-rating-card">
              <div class="zone-rating-row">
                <span class="zone-rating-label">Score global</span>
                <span class="zone-rating-badge" id="zm-badge">—</span>
              </div>
              <div class="zone-rating-row">
                <span class="zone-rating-value" id="zm-score">—</span>
                <span style="font-size:11px;color:var(--muted);">/ 100</span>
              </div>
              <div class="zone-rating-meta" id="zm-meta"></div>
            </div>

            <div class="zone-worst-banner" id="zm-worst" style="display:none;">
              ⚠️ Point chaud : <strong id="zm-worst-peril">—</strong> (<strong id="zm-worst-score">—</strong>/100)
            </div>

            <div class="zone-section-label">Marché immobilier (DVF)</div>
            <div class="zone-prix-card" id="zm-prix-card">
              <div class="zone-prix-row">
                <span class="zone-rating-label">Prix médian / m²</span>
                <span class="zone-prix-value" id="zm-prix-median">—</span>
              </div>
              <div class="zone-prix-meta" id="zm-prix-meta">Sélectionnez une ville pour voir les ventes DVF</div>
            </div>

            <div class="zone-section-label">Détail par péril</div>
            <div id="zm-perils"></div>
          </div>
        </div>
        <div id="zone-sample-info"></div>
      </div>

      <!-- Map -->
      <div id="zone-map-container">
        <div id="zone-map"></div>
        <div id="zone-legend">
          <div class="zone-legend-title">Niveau de risque</div>
          <div class="zone-legend-row"><span class="zone-legend-swatch" style="background:#1F9D6C;"></span>Faible (0–19)</div>
          <div class="zone-legend-row"><span class="zone-legend-swatch" style="background:#5ADB8A;"></span>Modéré bas (20–39)</div>
          <div class="zone-legend-row"><span class="zone-legend-swatch" style="background:#F5C542;"></span>Modéré (40–59)</div>
          <div class="zone-legend-row"><span class="zone-legend-swatch" style="background:#E27B2E;"></span>Élevé (60–79)</div>
          <div class="zone-legend-row"><span class="zone-legend-swatch" style="background:#C0392B;"></span>Critique (80–100)</div>
        </div>
        <div id="zone-legend-perils" style="display:none;">
          <div class="zone-legend-title">Aléas de la zone</div>
          <div id="zone-legend-perils-rows"></div>
        </div>
        <div id="zone-precision-badge">zoom 13 · grille 500 m</div>
        <div id="zone-annonces-badge"></div>
      </div>
    </div>
  </div>
</div>

<!-- ==================== ECRAN 1 : FORMULAIRE (diagnostic du bien) ==================== -->
<div id="form-screen">
  <div id="form-card">
    <div class="typhoon-logo">
      <div class="mark"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 4 5v6c0 5 3.5 9 8 11 4.5-2 8-6 8-11V5z"/><path d="m9 12 2 2 4-4"/></svg></div>
      <div>
        <div class="name">TYPHOON</div>
        <div class="baseline">Diagnostic Climatique Immobilier</div>
      </div>
    </div>
    <h1>Créez le jumeau numérique de votre bien</h1>
    <p class="subtitle">Indiquez simplement l'adresse du bien. Notre orchestrateur IA récupère automatiquement toutes ses caractéristiques via la BDNB, Géorisques et Copernicus — aucune saisie manuelle n'est nécessaire.</p>
    <form id="property-form">
      <div class="form-grid form-grid-simple">
        <div class="form-field full">
          <label for="f-adresse">Adresse du bien</label>
          <input id="f-adresse" type="text" placeholder="8 Allée du Port Maillard, 44000 Nantes" value="8 Allée du Port Maillard, 44000 Nantes" required autocomplete="off">
          <span class="field-hint">Numéro, voie, code postal, ville</span>
        </div>
      </div>

      <details id="form-advanced">
        <summary>Options avancées (dev)</summary>
        <div id="form-advanced-body">
          <div class="adv-row">
            <label for="api-base-input">API</label>
            <input id="api-base-input" type="text" value="http://localhost:8000" autocomplete="off">
          </div>
          <p class="adv-hint">Charger directement un diagnostic déjà généré (.json), sans appeler le serveur :</p>
          <div class="adv-row">
            <input id="json-input" type="file" accept="application/json">
          </div>
          <div class="adv-row">
            <button type="button" class="btn-ghost" id="demo-data-btn">Essayer avec un exemple (sans backend)</button>
          </div>
        </div>
      </details>

      <button type="submit" id="form-submit">Lancer le diagnostic climatique</button>
      <div id="form-disclaimer">Seule l'adresse est nécessaire : structure, toiture, sous-sol et exposition aux risques sont déterminés automatiquement via la BDNB, Géorisques et Copernicus. Diagnostic et recommandations fournis à titre indicatif, non contractuels.</div>
    </form>
  </div>
</div>

<!-- ==================== ECRAN 2 : ORCHESTRATION / TRAITEMENT ==================== -->
<div id="loading-screen">
  <div id="loading-card">
    <div class="typhoon-logo" style="justify-content:center;">
      <div class="mark"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 4 5v6c0 5 3.5 9 8 11 4.5-2 8-6 8-11V5z"/><path d="m9 12 2 2 4-4"/></svg></div>
      <div>
        <div class="name">TYPHOON</div>
        <div class="baseline">Diagnostic Climatique Immobilier</div>
      </div>
    </div>
    <div class="eyebrow">Analyse en cours</div>
    <div id="loading-title">Construction du jumeau numérique…</div>
    <div id="loading-steps">
      <div class="step" data-step="0"><div class="icon"></div><span>Géocodage de l'adresse et localisation de la parcelle</span></div>
      <div class="step" data-step="1"><div class="icon"></div><span>Croisement avec Géorisques (aléas retrait-gonflement, inondation)</span></div>
      <div class="step" data-step="2"><div class="icon"></div><span>Interrogation Copernicus (projections climatiques 2050)</span></div>
      <div class="step" data-step="3"><div class="icon"></div><span>Consultation BDNB (caractéristiques du bâti)</span></div>
      <div class="step" data-step="4"><div class="icon"></div><span>Fusion des données de risque et calcul des scores</span></div>
      <div class="step" data-step="5"><div class="icon"></div><span>Génération des recommandations par l'agent IA</span></div>
      <div class="step" data-step="6"><div class="icon"></div><span>Rendu du jumeau numérique 3D</span></div>
    </div>
    <div id="loading-bar-track"><div id="loading-bar-fill"></div></div>
    <div id="loading-error">
      <div id="loading-error-msg"></div>
      <button type="button" class="btn-ghost" id="loading-retry-btn">← Modifier l'adresse et réessayer</button>
    </div>
  </div>
</div>

<!-- ==================== ECRAN 3 : JUMEAU NUMERIQUE 3D (moteur réel) ==================== -->
<div id="app-ui">
<div id="scene-container"></div>
<div id="loading-msg" style="position:absolute;inset:0;display:none;align-items:center;justify-content:center;color:#FF6B4A;font-size:14px;z-index:20;"></div>

<div id="toggle-panel">
  <h3>Jumeau numérique — Diagnostic</h3>
  <div class="addr-line" id="addr-line">—</div>
  <div id="toggle-buttons">
    <button id="btn-2025" class="active">2025</button>
    <button id="btn-2050">2050</button>
  </div>
  <div id="global-score">Score global : <strong id="score-value">--</strong> / 100</div>
  <div style="margin-top:8px;">
    <a href="property-id/" style="color:var(--brand);font-size:12px;font-weight:700;text-decoration:none;display:inline-flex;align-items:center;gap:4px;">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
      Voir mon Property ID →
    </a>
  </div>
  <div id="climat-panel">
    <div style="font-size:11px;color:#FF6B4A;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;margin-bottom:4px;">Projection climatique 2050</div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:6px 10px;">
      <div><span style="color:#8B959D;font-size:10.5px;">🔥 Pic de chaleur max</span><br><strong id="temp-value" style="color:#DC4B39;font-size:15px;">—</strong></div>
      <div><span style="color:#8B959D;font-size:10.5px;">Précipitations</span><br><strong id="precip-value" style="color:#1F9D6C;font-size:15px;">—</strong></div>
      <div><span style="color:#8B959D;font-size:10.5px;">Jours canicule/an</span><br><strong id="canicule-value" style="color:#D98A2B;font-size:15px;">—</strong></div>
      <div><span style="color:#8B959D;font-size:10.5px;">Sources</span><br><span id="climat-sources-badge" style="font-size:10px;color:#A7ADB2;">—</span></div>
    </div>
    <div id="copernicus-badge" style="display:none;margin-top:6px;background:#FFE4DA;color:#FF6B4A;font-size:10px;padding:3px 8px;border-radius:999px;font-weight:700;">☁ Données Copernicus disponibles</div>
    <div id="dvf-badge" style="display:none;margin-top:4px;background:#E4F5EC;color:#1F9D6C;font-size:10px;padding:3px 8px;border-radius:999px;font-weight:700;">📊 Données de marché (DVF) disponibles</div>
  </div>
</div>

<div id="info-panel">
  <!-- Zone tabs -->
  <div id="info-zone-tabs"></div>

  <!-- Zone header -->
  <div id="info-zone-header" style="margin-bottom:8px;">
    <h3 id="info-title" style="margin:0 0 2px 0;font-size:15px;text-transform:capitalize;">Zone</h3>
    <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
      <div class="badge" id="info-badge" style="margin-bottom:0;">Risque</div>
      <p id="info-alea" style="margin:0;font-size:12px;color:#1E2A33;"></p>
    </div>
    <p id="info-justif" style="color:#8B959D;font-size:10.5px;margin:4px 0 0;"></p>
  </div>

  <!-- Cost summary -->
  <div id="info-cost-summary">
    <div class="cost-summary-row">
      <span class="cs-label">Cout total estime</span>
      <span class="cs-value" id="cs-total">—</span>
    </div>
    <div class="cost-summary-row">
      <span class="cs-label">Couverture aides</span>
      <span class="cs-value accent" id="cs-aides">—</span>
    </div>
    <div class="cost-summary-row">
      <span class="cs-label">Reste a charge estime</span>
      <span class="cs-value" id="cs-reste">—</span>
    </div>
    <div class="cost-summary-progress">
      <div class="cp-fill" id="cs-progress" style="width:0%"></div>
    </div>
  </div>

  <!-- Diagnostic compact -->
  <div id="info-conclusion" style="margin:8px 0 4px;padding:10px 12px;background:rgba(255,107,74,0.06);border:1px solid rgba(255,107,74,0.15);border-radius:8px;display:none;">
    <div id="info-diagnostic-header" style="font-size:12px;font-weight:700;color:#1E2A33;margin-bottom:6px;">Diagnostic & Risques</div>
    <div id="info-etat" style="font-size:12px;color:#4B5760;line-height:1.5;margin-bottom:8px;padding:6px 8px;background:rgba(255,255,255,0.5);border-radius:6px;"></div>
    <div id="info-facteurs-cles" style="font-size:10px;font-weight:700;color:#8B959D;text-transform:uppercase;letter-spacing:0.06em;margin-bottom:6px;">Facteurs Cles</div>
    <div id="info-facteurs" style="margin-top:0;">
      <div id="info-aggravants" style="margin-bottom:5px;"></div>
      <div id="info-attenuants"></div>
    </div>
  </div>

  <!-- Recommendations list -->
  <div id="info-recos"></div>
</div>

<div id="hint">Glisser = orbiter · Molette = zoom · Clic sur une zone = détails</div>

<div id="brand-watermark" title="Retour à l'accueil">
  <div class="mark"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 4 5v6c0 5 3.5 9 8 11 4.5-2 8-6 8-11V5z"/><path d="m9 12 2 2 4-4"/></svg></div>
  <span>TYPHOON</span>
</div>

<button id="devis-cta">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="15" x2="15" y2="15"/><line x1="9" y1="11" x2="11" y2="11"/></svg>
  Réaliser mon devis personnalisé
</button>

<!-- ==================== MODALE DEVIS PERSONNALISÉ ==================== -->
<div id="devis-overlay">
  <div id="devis-modal">
    <button id="devis-close-btn">✕</button>

    <div id="devis-select-view">
      <div class="typhoon-logo" style="margin-bottom:14px;">
        <div class="mark"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 4 5v6c0 5 3.5 9 8 11 4.5-2 8-6 8-11V5z"/><path d="m9 12 2 2 4-4"/></svg></div>
        <div>
          <div class="name" style="font-size:15px;">TYPHOON</div>
          <div class="baseline">Devis Climat-Résilience</div>
        </div>
      </div>
      <h2>Composez votre plan de travaux</h2>
      <p class="devis-sub">Sélectionnez les travaux que vous souhaitez engager. Chaque travaux réduit l'exposition climatique de votre bien et augmente votre éligibilité à la certification <strong>Climato-Résilient Typhoon</strong>, ouvrant droit à une prime sur votre cotisation d'assurance.</p>

      <div id="devis-list"></div>

      <div id="devis-summary">
        <div class="sum-block">
          <div class="label">Travaux sélectionnés</div>
          <div class="value" id="sum-count">0</div>
        </div>
        <div class="sum-block">
          <div class="label">Coût estimé</div>
          <div class="value" id="sum-cost">0€</div>
        </div>
        <div class="sum-block">
          <div class="label">Gain de résilience</div>
          <div class="value accent" id="sum-gain">+0%</div>
        </div>
        <div class="sum-block">
          <div class="label">Prime estimée</div>
          <div class="value accent" id="sum-prime">0%</div>
        </div>
      </div>

      <button id="devis-generate-btn" disabled>Générer mon devis de certification</button>
    </div>

    <div id="devis-result">
      <div id="cert-card">
        <div id="cert-shield"><svg viewBox="0 0 24 24" width="44" height="44" fill="none" stroke="#1F9D6C" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 4 5v6c0 5 3.5 9 8 11 4.5-2 8-6 8-11V5z"/><path d="m9 12 2 2 4-4"/></svg></div>
        <div id="cert-title">Certification Typhoon</div>
        <h2 id="cert-heading">Bien Climato-Résilient</h2>
        <p id="cert-property">—</p>

        <div id="cert-scores">
          <div class="cert-score-box">
            <div class="cert-score-label">Score avant</div>
            <div class="cert-score-value" id="cert-score-before" style="color:#D98A2B;">--</div>
          </div>
          <div class="cert-arrow">→</div>
          <div class="cert-score-box">
            <div class="cert-score-label">Score après travaux</div>
            <div class="cert-score-value" id="cert-score-after" style="color:#1F9D6C;">--</div>
          </div>
        </div>

        <div id="cert-prime">
          <div class="prime-label">Prime sur votre cotisation</div>
          <div class="prime-value" id="cert-prime-value">0%</div>
          <div class="prime-detail" id="cert-prime-detail">Réduction annuelle grâce à la réduction de votre exposition au risque climatique</div>
        </div>

        <div id="cert-works-list">
          <div class="cert-works-title">Travaux retenus dans ce devis</div>
          <ul id="cert-works-ul"></ul>
        </div>

        <div id="cert-actions">
          <button id="cert-back-btn">← Modifier ma sélection</button>
          <button id="cert-download-btn">Télécharger le devis</button>
          <button id="cert-property-id-btn" style="background:var(--brand);color:#fff;border:none;border-radius:8px;padding:10px 20px;font-weight:700;font-size:13px;cursor:pointer;font-family:inherit;transition:background .15s;box-shadow:0 4px 14px rgba(255,107,74,0.3);width:100%;margin-top:6px;">Voir mon Property ID certifié →</button>
        </div>
        <div id="cert-footnote">Typhoon — devis indicatif non contractuel, généré automatiquement par l'agent IA de diagnostic climatique.</div>
      </div>
    </div>
  </div>
</div>

