<!-- Uniquement le coeur de Three.js. Pas de THREE.OrbitControls (peu fiable
     sur les CDN) : contrôle caméra personnalisé plus bas. -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
if (typeof THREE === 'undefined') {
  document.body.innerHTML = '<div style="color:#1E2A33;background:#FFF5F3;padding:30px;font-family:sans-serif;max-width:600px;margin:60px auto;border-radius:10px;border:1px solid #F3D9D2;">' +
    '<h2 style="color:#DC4B39;">Three.js ne s\'est pas chargé</h2>' +
    '<p>Vérifiez votre connexion internet ou essayez un autre réseau.</p></div>';
  throw new Error('THREE non chargé');
}
</script>
<script>
/* =========================================================================
   TYPHOON — JUMEAU NUMÉRIQUE 3D — moteur réel (diagnostic du bien)
   Consomme le contrat JSON produit par digital_twin_agent :
   { adresse, bien, geometry, score_global, zones{7}, projection_2050, climat_2050 }
   Rendu : effet scan holographique (remplissage translucide + wireframe bleu),
   couleur des zones = niveau de risque, effets visuels (fissures / montée des
   eaux / auréoles d'humidité) pilotés par une fonction de mapping pure
   risque -> paramètres visuels. Cet écran est affiché uniquement une fois
   qu'un diagnostic (réel ou exemple) a été chargé — voir le script
   d'orchestration plus bas.
   ========================================================================= */

// ---------- 0. DONNÉES D'EXEMPLE (utilisées par le bouton "essayer sans backend") ----------
const DEFAULT_DATA = {
  "adresse": "12 rue des Lilas, 33000 Bordeaux",
  "bien": { "type": "maison individuelle", "annee_construction": 1975, "coordonnees": { "lat": 44.8378, "lon": -0.5792 } },
  "geometry": {
    "footprint_shape": "rectangulaire",
    "largeur_m": 8.5, "longueur_m": 10.2, "orientation_deg": 15,
    "floors_count": 2, "hauteur_sous_plafond_m": 2.6,
    "roof_shape": "deux_pans", "pente_toit_deg": 35,
    "materiau_mur": "parpaing_enduit", "materiau_toiture": "tuiles_terre_cuite",
    "has_basement": true, "has_cellar": false,
    "has_garage": true, "garage_position": "ouest",
    "has_garden": true, "garden_surface_m2": 250
  },
  "score_global": 58,
  "zones": {
    "fondations": { "risque": 78, "niveau": "eleve", "alea_principal": "Retrait-gonflement des argiles", "justification": "Sol argileux identifié en zone d'aléa fort, aggravé par l'alternance sécheresse/humidité.", "recommandations": [
      { "travaux": "Renforcement des fondations par micropieux", "cout_estime": "9000-16000€", "gain_resilience": 30 },
      { "travaux": "Drainage périphérique", "cout_estime": "3000-6000€", "gain_resilience": 15 }
    ]},
    "murs_nord": { "risque": 35, "niveau": "modere", "alea_principal": "Infiltration", "justification": "Exposition nord avec humidité résiduelle plus fréquente.", "recommandations": [
      { "travaux": "Traitement hydrofuge de façade", "cout_estime": "1500-3000€", "gain_resilience": 12 }
    ]},
    "murs_sud": { "risque": 20, "niveau": "faible", "alea_principal": "Stress thermique", "justification": "Exposition sud correcte, matériaux jugés stables.", "recommandations": [] },
    "murs_est": { "risque": 28, "niveau": "faible", "alea_principal": "Vent", "justification": "Exposition modérée aux vents dominants.", "recommandations": [] },
    "murs_ouest": { "risque": 42, "niveau": "modere", "alea_principal": "Intempéries", "justification": "Façade la plus exposée aux intempéries selon l'historique CATNAT local.", "recommandations": [
      { "travaux": "Renforcement bardage", "cout_estime": "2000-4000€", "gain_resilience": 10 }
    ]},
    "toiture": { "risque": 55, "niveau": "modere", "alea_principal": "Canicule / stress thermique", "justification": "Isolation actuelle insuffisante face à l'augmentation prévue des épisodes caniculaires.", "recommandations": [
      { "travaux": "Isolation thermique renforcée", "cout_estime": "6000-11000€", "gain_resilience": 22 }
    ]},
    "sous_sol": { "risque": 65, "niveau": "eleve", "alea_principal": "Inondation / remontée de nappe", "justification": "Proximité d'un cours d'eau avec historique d'inondation dans le secteur.", "recommandations": [
      { "travaux": "Pose de batardeaux et clapet anti-retour", "cout_estime": "2500-5000€", "gain_resilience": 20 }
    ]}
  },
  "projection_2050": {
    "score_global": 81,
    "zones": {
      "fondations": { "risque": 92, "niveau": "critique", "alea_principal": "RGA aggravé", "justification": "Sécheresses prolongées prévues en 2050, risque de fissuration majeure.", "recommandations": [{ "travaux": "Renforcement fondations + surveillance annuelle", "cout_estime": "9000-16000€", "gain_resilience": 35 }] },
      "murs_nord":  { "risque": 48, "niveau": "modere", "alea_principal": "Infiltration accrue", "justification": "Augmentation des précipitations intenses en hiver.", "recommandations": [{ "travaux": "Traitement hydrofuge de façade", "cout_estime": "1500-3000€", "gain_resilience": 15 }] },
      "murs_sud":   { "risque": 40, "niveau": "modere", "alea_principal": "Stress thermique", "justification": "Canicules plus longues, exposition sud plus sensible.", "recommandations": [{ "travaux": "Volets isolants", "cout_estime": "1200-2500€", "gain_resilience": 10 }] },
      "murs_est":   { "risque": 38, "niveau": "modere", "alea_principal": "Vent renforcé", "justification": "Intensification des épisodes de vent fort.", "recommandations": [] },
      "murs_ouest": { "risque": 60, "niveau": "eleve", "alea_principal": "Intempéries renforcées", "justification": "Façade la plus exposée, aggravation attendue.", "recommandations": [{ "travaux": "Renforcement bardage renforcé", "cout_estime": "2000-4000€", "gain_resilience": 18 }] },
      "toiture":    { "risque": 80, "niveau": "eleve", "alea_principal": "Canicule prolongée", "justification": "Périodes de canicule estimées à plusieurs mois en 2050.", "recommandations": [{ "travaux": "Isolation thermique renforcée + ventilation", "cout_estime": "6000-11000€", "gain_resilience": 30 }] },
      "sous_sol":   { "risque": 85, "niveau": "critique", "alea_principal": "Inondation aggravée", "justification": "Augmentation de 30% des sinistres climatiques attendue d'ici 2050.", "recommandations": [{ "travaux": "Batardeaux + pompe de relevage", "cout_estime": "3500-7000€", "gain_resilience": 28 }] }
    }
  },
  "climat_2050": { "temperature_max_projetee_c": 41.5, "source": "Copernicus" }
};

const ZONE_NAMES = ["fondations", "murs_nord", "murs_sud", "murs_est", "murs_ouest", "toiture", "sous_sol"];

// ---------- 1. FONCTION DE MAPPING RISQUE -> EFFET VISUEL (pure, déterministe) ----------
function mapRiskToEffect(zoneName, score) {
  const s = Math.max(0, Math.min(100, score));
  if (zoneName === "fondations") {
    let opacity = 0, layers = 0;
    if (s >= 60) { opacity = 0.55 + (s - 60) / 40 * 0.40; layers = s >= 85 ? 3 : 2; }
    else if (s >= 30) { opacity = 0.12 + (s - 30) / 30 * 0.35; layers = 1; }
    return { crackOpacity: Math.min(opacity, 0.95), crackLayers: layers };
  }
  if (zoneName === "sous_sol") {
    let ratio = 0;
    if (s >= 60) ratio = 0.5 + (s - 60) / 40 * 0.5;
    else if (s >= 30) ratio = (s - 30) / 30 * 0.5;
    return { waterHeightRatio: Math.min(ratio, 1) };
  }
  if (zoneName === "toiture") {
    let wear = 0;
    if (s >= 60) wear = 0.4 + (s - 60) / 40 * 0.6;
    else if (s >= 30) wear = (s - 30) / 30 * 0.4;
    return { tileWear: Math.min(wear, 1) };
  }
  if (zoneName.startsWith("murs_")) {
    let stain = 0;
    if (s >= 70) stain = 0.3 + (s - 70) / 30 * 0.5;
    else if (s >= 40) stain = (s - 40) / 30 * 0.3;
    return { humidityOpacity: Math.min(stain, 0.85) };
  }
  return {};
}

// ---------- 2. SCÈNE THREE.JS ----------
const container = document.getElementById('scene-container');
const scene = new THREE.Scene();
// Fond legerement remonte : sur les ecrans peu contrastes, le 0x04070c
// d'origine rendait les aretes sombres indiscernables du noir.
const FOND_SCENE = 0x080e18;
scene.background = new THREE.Color(FOND_SCENE);
// Distances recalculees par fitCameraToHouse en fonction de la taille du
// bati : ces valeurs ne sont que l'amorce avant le premier diagnostic.
scene.fog = new THREE.Fog(FOND_SCENE, 20, 55);

const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 1000);
const renderer = new THREE.WebGLRenderer({ antialias: true });
renderer.setSize(window.innerWidth, window.innerHeight);
renderer.setPixelRatio(window.devicePixelRatio);
container.appendChild(renderer.domElement);

scene.add(new THREE.HemisphereLight(0x3a7bd5, 0x04070c, 0.7));
const rim = new THREE.DirectionalLight(0x4da6ff, 0.5); rim.position.set(-8, 10, -6); scene.add(rim);
const key = new THREE.DirectionalLight(0xbfe0ff, 0.4); key.position.set(8, 12, 8); scene.add(key);

const grid = new THREE.GridHelper(60, 60, 0x1560ff, 0x0d2647);
grid.material.transparent = true; grid.material.opacity = 0.45;
scene.add(grid);

const ringGeo = new THREE.RingGeometry(6.5, 6.7, 64);
const ringMat = new THREE.MeshBasicMaterial({ color: 0x4da6ff, transparent: true, opacity: 0.5, side: THREE.DoubleSide });
const scanRing = new THREE.Mesh(ringGeo, ringMat);
scanRing.rotation.x = -Math.PI / 2; scanRing.position.y = 0.01;
scene.add(scanRing);

const WIRE_COLOR = 0x5fb2ff;

// --- Réglage de la luminosité de la scène ---
// Les volumes de la maison sont des MeshBasicMaterial en blending additif :
// ils n'ont PAS de normales éclairées et ignorent donc complètement les
// HemisphereLight/DirectionalLight ajoutées plus haut. Leur clarté ne dépend
// que de leur opacité — c'est ce coefficient qu'il faut toucher pour
// éclaircir le rendu, pas l'intensité des lumières.
// 1.0 = rendu d'origine. Au-delà de ~2.4 les zones se superposent et les
// couleurs de risque deviennent difficiles à distinguer les unes des autres.
const LUMINOSITE = 1.9;
const OPACITE_FILAIRE = 1.0;   // aretes : 0.85 a l'origine

function makeWireMat() { return new THREE.LineBasicMaterial({ color: WIRE_COLOR, transparent: true, opacity: OPACITE_FILAIRE }); }
function makeFillMat(color, opacity) {
  // Plafond a 0.9 : au-dela, l'additif sature en blanc et la couleur de
  // risque (vert/orange/rouge) n'est plus lisible.
  const opacite = Math.min(0.9, (opacity ?? 0.16) * LUMINOSITE);
  return new THREE.MeshBasicMaterial({ color, transparent: true, opacity: opacite, side: THREE.DoubleSide, blending: THREE.AdditiveBlending, depthWrite: false });
}
function addPart(group, geometry, position, fillColor, opacity) {
  const fill = new THREE.Mesh(geometry, makeFillMat(fillColor, opacity));
  if (position) fill.position.copy(position);
  group.add(fill);
  const wire = new THREE.LineSegments(new THREE.EdgesGeometry(geometry), makeWireMat());
  if (position) wire.position.copy(position);
  group.add(wire);
  return fill;
}
function addRawPart(group, bufferGeometry, fillColor, opacity) {
  bufferGeometry.computeVertexNormals();
  const fill = new THREE.Mesh(bufferGeometry, makeFillMat(fillColor, opacity));
  group.add(fill);
  const wire = new THREE.LineSegments(new THREE.EdgesGeometry(bufferGeometry), makeWireMat());
  group.add(wire);
  return fill;
}

// ---------- 3. CANEVAS PROCÉDURAUX (fissures / auréoles) ----------
function makeCrackTexture(layers) {
  const c = document.createElement('canvas'); c.width = 512; c.height = 512;
  const ctx = c.getContext('2d');
  ctx.clearRect(0, 0, 512, 512);
  ctx.strokeStyle = 'rgba(255,255,255,0.95)';
  ctx.shadowColor = 'rgba(255,80,60,0.9)'; ctx.shadowBlur = 4;
  const rand = mulberry32(42);
  for (let l = 0; l < Math.max(1, layers); l++) {
    let x = 80 + rand() * 350, y = 40;
    ctx.lineWidth = 2 + rand() * 2;
    ctx.beginPath(); ctx.moveTo(x, y);
    for (let i = 0; i < 14; i++) {
      x += (rand() - 0.5) * 70;
      y += 30 + rand() * 20;
      ctx.lineTo(x, Math.min(y, 500));
      if (rand() > 0.6) {
        const bx = x + (rand() - 0.5) * 60, by = y + rand() * 40;
        ctx.moveTo(x, y); ctx.lineTo(bx, Math.min(by, 500)); ctx.moveTo(x, y);
      }
    }
    ctx.stroke();
  }
  return new THREE.CanvasTexture(c);
}
function makeStainTexture() {
  const c = document.createElement('canvas'); c.width = 512; c.height = 512;
  const ctx = c.getContext('2d');
  const grd = ctx.createRadialGradient(256, 380, 10, 256, 380, 260);
  grd.addColorStop(0, 'rgba(140,180,255,0.85)');
  grd.addColorStop(0.5, 'rgba(100,140,220,0.35)');
  grd.addColorStop(1, 'rgba(100,140,220,0)');
  ctx.fillStyle = grd; ctx.fillRect(0, 0, 512, 512);
  return new THREE.CanvasTexture(c);
}
function mulberry32(seed) {
  return function () {
    seed |= 0; seed = (seed + 0x6D2B79F5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const crackTextures = { 1: makeCrackTexture(1), 2: makeCrackTexture(2), 3: makeCrackTexture(3) };
const stainTexture = makeStainTexture();

// ---------- 4. CONSTRUCTION PARAMÉTRIQUE DE LA MAISON ----------
let house = null, zoneGroups = {}, zoneFillMeshes = {}, interactiveMeshes = [];
let crackMesh = null, waterMesh = null, stainMeshes = {};
let houseDims = {};
let labelSprites = {}, leaderLines = {};
// Point + normale representatifs de chaque façade, renseignes uniquement en
// mode emprise reelle : sur un polygone quelconque, "le mur nord" n'est plus
// a z = -D/2, il faut retenir l'arete reellement construite pour y accrocher
// les etiquettes et les effets (auréoles d'humidite).
let zoneAnchors = {};

function disposeHouse() {
  if (house) scene.remove(house);
  house = null; zoneGroups = {}; zoneFillMeshes = {}; interactiveMeshes = [];
  crackMesh = null; waterMesh = null; stainMeshes = {};
  labelSprites = {}; leaderLines = {}; zoneAnchors = {};
}

function registerFill(zoneName, fillMesh) {
  fillMesh.userData.zoneName = zoneName;
  zoneFillMeshes[zoneName].push(fillMesh);
  interactiveMeshes.push(fillMesh);
}

// ---------- 4a. EMPRISE RÉELLE (polygone BDNB) ----------
// `geometry.footprint` arrive deja en metres, dans le repere de la scene
// (x = Est, z = Sud, origine au centre du bati) : aucune reprojection ici,
// c'est `app/digital_twin/footprint.py` qui s'en charge cote backend.

function footprintPolygons(g) {
  const fp = g && g.footprint;
  if (!fp || !Array.isArray(fp.polygones)) return null;
  const polys = fp.polygones
    .map(p => ({
      ext: (p.exterieur || []).filter(pt => Array.isArray(pt) && pt.length >= 2).map(pt => [+pt[0], +pt[1]]),
      holes: (p.trous || []).map(t => t.filter(pt => Array.isArray(pt) && pt.length >= 2).map(pt => [+pt[0], +pt[1]])).filter(t => t.length >= 3)
    }))
    .filter(p => p.ext.length >= 3 && p.ext.every(pt => isFinite(pt[0]) && isFinite(pt[1])));
  return polys.length ? polys : null;
}

function polygonBounds(polys) {
  let minX = Infinity, maxX = -Infinity, minZ = Infinity, maxZ = -Infinity;
  polys.forEach(p => p.ext.forEach(([x, z]) => {
    minX = Math.min(minX, x); maxX = Math.max(maxX, x);
    minZ = Math.min(minZ, z); maxZ = Math.max(maxZ, z);
  }));
  return { minX, maxX, minZ, maxZ, W: maxX - minX, D: maxZ - minZ };
}

// THREE.Shape vit dans le plan XY et s'extrude vers +Z. On construit donc la
// forme en (x, -z) puis on couche le mesh avec rotation.x = -90°, ce qui
// renvoie shape.y sur la scene z ET oriente l'extrusion vers le haut.
const SHAPE_ROT_X = -Math.PI / 2;
function toShape(ext, holes) {
  const shape = new THREE.Shape();
  ext.forEach((p, i) => i ? shape.lineTo(p[0], -p[1]) : shape.moveTo(p[0], -p[1]));
  shape.closePath();
  (holes || []).forEach(h => {
    const path = new THREE.Path();
    h.forEach((p, i) => i ? path.lineTo(p[0], -p[1]) : path.moveTo(p[0], -p[1]));
    path.closePath();
    shape.holes.push(path);
  });
  return shape;
}

// Dalle horizontale (fondations, plancher, toit-terrasse) suivant l'emprise.
function slabFromPolygons(polys, y, thickness) {
  const group = [];
  polys.forEach(p => {
    const geo = new THREE.ExtrudeGeometry(toShape(p.ext, p.holes), { depth: thickness, bevelEnabled: false });
    geo.rotateX(SHAPE_ROT_X);
    geo.translate(0, y, 0);
    group.push(geo);
  });
  return group;
}

function quadsToGeometry(quads) {
  const verts = new Float32Array(quads.length * 18);
  quads.forEach((q, i) => {
    const [a, b, c, d] = q;
    verts.set([...a, ...b, ...c, ...a, ...c, ...d], i * 18);
  });
  const geo = new THREE.BufferGeometry();
  geo.setAttribute('position', new THREE.BufferAttribute(verts, 3));
  geo.computeVertexNormals();
  return geo;
}

// Normale sortante d'une arete : le contour exterieur arrive en sens
// trigonometrique et les trous en sens horaire (garanti par le backend),
// donc (dz, -dx) pointe toujours vers l'exterieur de la matiere — y compris
// pour une cour interieure, ou elle pointe vers la cour.
function edgeNormal(p, q) {
  const dx = q[0] - p[0], dz = q[1] - p[1];
  const len = Math.hypot(dx, dz) || 1;
  return [dz / len, -dx / len];
}

function cardinalZone(normal) {
  const [nx, nz] = normal;
  if (Math.abs(nx) > Math.abs(nz)) return nx > 0 ? 'murs_est' : 'murs_ouest';
  return nz > 0 ? 'murs_sud' : 'murs_nord';
}

function ringEdges(ring) {
  return ring.map((p, i) => [p, ring[(i + 1) % ring.length]]);
}

function pointInRing(x, z, ring) {
  let inside = false;
  for (let i = 0, n = ring.length; i < n; i++) {
    const [x1, z1] = ring[i], [x2, z2] = ring[(i + 1) % n];
    if ((z1 > z) !== (z2 > z)) {
      const xCross = x1 + (z - z1) / (z2 - z1) * (x2 - x1);
      if (xCross > x) inside = !inside;
    }
  }
  return inside;
}

// Contour rentre d'une distance `d` (jointure en onglet). Sert a fabriquer
// une toiture a pans sur une emprise quelconque : le contour rentre devient
// le faitage, ce qui donne une croupe correcte sur un L ou un U la ou une
// simple boite ne savait produire que deux pans droits.
function insetRing(ring, d) {
  const n = ring.length;
  const out = [];
  for (let i = 0; i < n; i++) {
    const prev = ring[(i - 1 + n) % n], cur = ring[i], next = ring[(i + 1) % n];
    const e1 = [cur[0] - prev[0], cur[1] - prev[1]];
    const e2 = [next[0] - cur[0], next[1] - cur[1]];
    const l1 = Math.hypot(e1[0], e1[1]), l2 = Math.hypot(e2[0], e2[1]);
    if (l1 < 1e-6 || l2 < 1e-6) return null;
    // normale rentrante = -(normale sortante)
    const n1 = [-e1[1] / l1, e1[0] / l1];
    const n2 = [-e2[1] / l2, e2[0] / l2];
    const bis = [n1[0] + n2[0], n1[1] + n2[1]];
    const bl = Math.hypot(bis[0], bis[1]);
    if (bl < 1e-6) return null;              // demi-tour : onglet indefini
    const m = [bis[0] / bl, bis[1] / bl];
    const cosHalf = n1[0] * m[0] + n1[1] * m[1];
    if (cosHalf < 0.2) return null;          // angle trop aigu : pic aberrant
    const scale = d / cosHalf;
    out.push([cur[0] + m[0] * scale, cur[1] + m[1] * scale]);
  }
  // Un contour rentre valide reste a l'interieur du contour d'origine ;
  // sinon l'emprise est trop etroite pour cette pente et on renonce.
  if (!out.every(([x, z]) => pointInRing(x, z, ring))) return null;
  return out;
}

function buildHouseFromFootprint(geometry, polys) {
  disposeHouse();
  const g = geometry || {};
  const bounds = polygonBounds(polys);
  const W = bounds.W, D = bounds.D;
  const floors = Math.max(1, Math.min(8, Math.round(g.floors_count ?? 1)));
  const levelH = clamp(g.hauteur_sous_plafond_m ?? 2.6, 2.0, 3.5);
  const roofShape = (g.roof_shape || 'deux_pans').toLowerCase();
  const penteDeg = clamp(g.pente_toit_deg ?? 35, 12, 55);
  const hasBasement = g.has_basement !== false;
  const estImmeuble = g.type_batiment === 'immeuble';

  house = new THREE.Group();
  scene.add(house);
  ZONE_NAMES.forEach(name => {
    const grp = new THREE.Group(); grp.name = name;
    house.add(grp); zoneGroups[name] = grp; zoneFillMeshes[name] = [];
  });

  const basementTopY = 0.4;
  const basementH = hasBasement ? 1.6 : 0.35;
  const basementCenterY = basementTopY - basementH / 2;
  const fondY = basementTopY + 0.15;
  const wallsStartY = basementTopY + 0.3;
  const eavesY = wallsStartY + floors * levelH;

  // -- sous-sol et fondations : extrusion de l'emprise reelle --
  slabFromPolygons(polys, basementTopY - basementH, basementH).forEach(geo =>
    registerFill('sous_sol', addRawPart(zoneGroups.sous_sol, geo, 0x3fb950, 0.18)));
  slabFromPolygons(polys, fondY - 0.15, 0.3).forEach(geo =>
    registerFill('fondations', addRawPart(zoneGroups.fondations, geo, 0x3fb950, 0.18)));

  // -- murs : une facade par arete, rattachee a sa zone cardinale --
  const wallQuads = {};       // zone -> etage -> quads
  ZONE_NAMES.filter(z => z.startsWith('murs_')).forEach(z => { wallQuads[z] = {}; });
  const anchorCandidates = {};

  polys.forEach(p => {
    const rings = [p.ext].concat(p.holes || []);
    rings.forEach(ring => {
      ringEdges(ring).forEach(([a, b]) => {
        const normal = edgeNormal(a, b);
        const zone = cardinalZone(normal);
        const longueur = Math.hypot(b[0] - a[0], b[1] - a[1]);
        if (longueur < 0.05) return;

        for (let i = 0; i < floors; i++) {
          const y0 = wallsStartY + i * levelH;
          const y1 = y0 + levelH;
          (wallQuads[zone][i] = wallQuads[zone][i] || []).push([
            [a[0], y0, a[1]], [b[0], y0, b[1]], [b[0], y1, b[1]], [a[0], y1, a[1]]
          ]);
        }
        // La façade la plus longue de chaque orientation porte l'etiquette
        // et l'effet d'humidite : c'est la plus lisible a l'ecran.
        if (!anchorCandidates[zone] || longueur > anchorCandidates[zone].longueur) {
          anchorCandidates[zone] = {
            longueur,
            milieu: [(a[0] + b[0]) / 2, (a[1] + b[1]) / 2],
            normal
          };
        }
      });
    });
  });

  Object.entries(wallQuads).forEach(([zone, parEtage]) => {
    Object.values(parEtage).forEach(quads => {
      if (quads.length) registerFill(zone, addRawPart(zoneGroups[zone], quadsToGeometry(quads), 0x3fb950, 0.16));
    });
  });

  Object.entries(anchorCandidates).forEach(([zone, info]) => {
    zoneAnchors[zone] = {
      position: new THREE.Vector3(info.milieu[0], wallsStartY + levelH / 2, info.milieu[1]),
      normal: new THREE.Vector3(info.normal[0], 0, info.normal[1])
    };
  });

  // -- planchers intermediaires : simple filaire suivant l'emprise --
  for (let i = 1; i < floors; i++) {
    const bandY = wallsStartY + i * levelH;
    polys.forEach(p => {
      [p.ext].concat(p.holes || []).forEach(ring => {
        const pts = ring.map(([x, z]) => new THREE.Vector3(x, bandY, z));
        pts.push(pts[0].clone());
        const line = new THREE.Line(new THREE.BufferGeometry().setFromPoints(pts),
          new THREE.LineBasicMaterial({ color: WIRE_COLOR, transparent: true, opacity: 0.55 }));
        house.add(line);
      });
    });
  }

  // -- toiture --
  // Toit-terrasse pour les immeubles et les toits plats ; sinon, croupe
  // obtenue en rentrant le contour (voir insetRing). Une emprise a cour
  // interieure part aussi en terrasse : rentrer un contour troue n'a pas de
  // solution simple et fiable, et ces batis sont massivement en terrasse.
  const aCour = polys.some(p => (p.holes || []).length > 0);
  const toitPlat = estImmeuble || aCour || roofShape === 'plat' || roofShape === 'toit_plat';
  let ridgeY = eavesY;

  if (toitPlat) {
    slabFromPolygons(polys, eavesY, 0.25).forEach(geo =>
      registerFill('toiture', addRawPart(zoneGroups.toiture, geo, 0x3fb950, 0.16)));
    ridgeY = eavesY + 0.25;
  } else {
    const penteRad = penteDeg * Math.PI / 180;
    polys.forEach(p => {
      const inset = Math.min(2.0, Math.max(0.8, Math.min(W, D) * 0.18));
      let creux = null, retenu = inset;
      for (let essai = 0; essai < 4 && !creux; essai++) {
        retenu = inset / Math.pow(2, essai);
        creux = insetRing(p.ext, retenu);
      }
      const rise = (creux ? retenu : 0) * Math.tan(penteRad);
      const sommetY = eavesY + rise;
      ridgeY = Math.max(ridgeY, sommetY);

      if (!creux) {
        // Emprise trop etroite ou trop torturee pour une croupe : terrasse.
        slabFromPolygons([p], eavesY, 0.25).forEach(geo =>
          registerFill('toiture', addRawPart(zoneGroups.toiture, geo, 0x3fb950, 0.16)));
        return;
      }

      const pans = ringEdges(p.ext).map(([a, b], i) => {
        const j = (i + 1) % p.ext.length;
        return [
          [a[0], eavesY, a[1]], [b[0], eavesY, b[1]],
          [creux[j][0], sommetY, creux[j][1]], [creux[i][0], sommetY, creux[i][1]]
        ];
      });
      registerFill('toiture', addRawPart(zoneGroups.toiture, quadsToGeometry(pans), 0x3fb950, 0.16));

      const faitage = new THREE.ExtrudeGeometry(toShape(creux, []), { depth: 0.06, bevelEnabled: false });
      faitage.rotateX(SHAPE_ROT_X);
      faitage.translate(0, sommetY, 0);
      registerFill('toiture', addRawPart(zoneGroups.toiture, faitage, 0x3fb950, 0.16));
    });
  }

  buildAnnexes(g, {
    minX: bounds.minX, maxX: bounds.maxX, minZ: bounds.minZ, maxZ: bounds.maxZ,
    W, D, wallsStartY, basementTopY
  });

  // Pas de rotation : l'orientation reelle est deja portee par les
  // coordonnees du polygone (contrairement au mode boite, ou elle doit etre
  // rejouee via orientation_deg).
  houseDims = { W, D, floors, levelH, wallsStartY, eavesY, ridgeY, basementCenterY, fondY, bounds };
}

// Garage et jardin : decor commun aux deux modes de construction.
function buildAnnexes(g, dims) {
  const hasGarage = !!g.has_garage;
  const garagePos = g.garage_position || 'ouest';
  const hasGarden = !!g.has_garden;
  const decor = new THREE.Group(); house.add(decor);

  function addDecorPanel(geometry, position) {
    const fill = new THREE.Mesh(geometry, makeFillMat(0x5fb2ff, 0.22));
    fill.position.copy(position); decor.add(fill);
    const wire = new THREE.LineSegments(new THREE.EdgesGeometry(geometry), makeWireMat());
    wire.position.copy(position); decor.add(wire);
  }

  if (hasGarage) {
    const garageW = 3.0, garageD = 4.2, garageH = 2.4;
    let gx = 0, gz = 0;
    if (garagePos === 'ouest') gx = dims.minX - garageW / 2 - 0.05;
    else if (garagePos === 'est') gx = dims.maxX + garageW / 2 + 0.05;
    else if (garagePos === 'nord') gz = dims.minZ - garageD / 2 - 0.05;
    else gz = dims.maxZ + garageD / 2 + 0.05;
    const baseY = dims.wallsStartY - 0.3;
    addDecorPanel(new THREE.BoxGeometry(garageW, garageH, garageD), new THREE.Vector3(gx, baseY + garageH / 2, gz));
    addDecorPanel(new THREE.BoxGeometry(garageW + 0.3, 0.1, garageD + 0.3), new THREE.Vector3(gx, baseY + garageH + 0.05, gz));
  }

  if (hasGarden) {
    const side = hasGarage && garagePos === 'ouest' ? 1 : -1;
    const size = Math.sqrt(clamp(g.garden_surface_m2 ?? 100, 20, 2000));
    const gardenMesh = new THREE.Mesh(
      new THREE.PlaneGeometry(size, size),
      new THREE.MeshBasicMaterial({ color: 0x3fb950, transparent: true, opacity: 0.08, side: THREE.DoubleSide })
    );
    gardenMesh.rotation.x = -Math.PI / 2;
    const x = side > 0 ? dims.maxX + size / 2 + 1.2 : dims.minX - size / 2 - 1.2;
    gardenMesh.position.set(x, 0.02, (dims.minZ + dims.maxZ) / 2);
    house.add(gardenMesh);
  }
}

function buildHouse(geometry) {
  const polys = footprintPolygons(geometry);
  if (polys) buildHouseFromFootprint(geometry, polys);
  else buildHouseFromBox(geometry);
  buildLabels();
  buildEffectMeshes();
}

function buildHouseFromBox(geometry) {
  disposeHouse();
  const g = geometry || {};
  const W = clamp(g.largeur_m ?? 8, 3, 35);
  const D = clamp(g.longueur_m ?? 8, 3, 35);
  const floors = Math.max(1, Math.min(6, Math.round(g.floors_count ?? 1)));
  const levelH = clamp(g.hauteur_sous_plafond_m ?? 2.6, 2.0, 3.5);
  const roofShape = (g.roof_shape || 'deux_pans').toLowerCase();
  const penteDeg = clamp(g.pente_toit_deg ?? 35, 12, 55);
  const hasBasement = g.has_basement !== false;
  const hasGarage = !!g.has_garage;
  const garagePos = g.garage_position || 'ouest';
  const hasGarden = !!g.has_garden;
  const orientationDeg = g.orientation_deg ?? 0;

  house = new THREE.Group();
  scene.add(house);

  ZONE_NAMES.forEach(name => {
    const grp = new THREE.Group(); grp.name = name;
    house.add(grp); zoneGroups[name] = grp; zoneFillMeshes[name] = [];
  });

  const basementTopY = 0.4;
  const basementH = hasBasement ? 1.6 : 0.35;
  const basementCenterY = basementTopY - basementH / 2;
  const fondY = basementTopY + 0.15;
  const wallsStartY = basementTopY + 0.3;
  const eavesY = wallsStartY + floors * levelH;

  registerFill("sous_sol", addPart(zoneGroups.sous_sol,
    new THREE.BoxGeometry(W + 0.3, basementH, D + 0.3),
    new THREE.Vector3(0, basementCenterY, 0), 0x3fb950, 0.18));

  registerFill("fondations", addPart(zoneGroups.fondations,
    new THREE.BoxGeometry(W + 0.4, 0.3, D + 0.4),
    new THREE.Vector3(0, fondY, 0), 0x3fb950, 0.18));

  const wallThickness = 0.2;
  function buildWallLevels(zoneName, sizeFn, posFn) {
    for (let i = 0; i < floors; i++) {
      const y = wallsStartY + i * levelH + levelH / 2;
      registerFill(zoneName, addPart(zoneGroups[zoneName], sizeFn(), posFn(y), 0x3fb950, 0.16));
    }
  }
  buildWallLevels("murs_nord", () => new THREE.BoxGeometry(W, levelH, wallThickness), y => new THREE.Vector3(0, y, -D / 2));
  buildWallLevels("murs_sud",  () => new THREE.BoxGeometry(W, levelH, wallThickness), y => new THREE.Vector3(0, y, D / 2));
  buildWallLevels("murs_est",  () => new THREE.BoxGeometry(wallThickness, levelH, D), y => new THREE.Vector3(W / 2, y, 0));
  buildWallLevels("murs_ouest",() => new THREE.BoxGeometry(wallThickness, levelH, D), y => new THREE.Vector3(-W / 2, y, 0));

  for (let i = 1; i < floors; i++) {
    const bandY = wallsStartY + i * levelH;
    const bandGeo = new THREE.BoxGeometry(W + 0.15, 0.06, D + 0.15);
    const bandFill = new THREE.Mesh(bandGeo, makeFillMat(0x5fb2ff, 0.25));
    bandFill.position.set(0, bandY, 0); house.add(bandFill);
    const bandWire = new THREE.LineSegments(new THREE.EdgesGeometry(bandGeo), makeWireMat());
    bandWire.position.copy(bandFill.position); house.add(bandWire);
  }

  const roofOverhang = 0.35;
  const roofHalfSpan = D / 2 + roofOverhang;
  let ridgeY = eavesY;

  if (roofShape === 'plat' || roofShape === 'toit_plat') {
    const slabGeo = new THREE.BoxGeometry(W + 0.6, 0.25, D + 0.6);
    registerFill("toiture", addPart(zoneGroups.toiture, slabGeo, new THREE.Vector3(0, eavesY + 0.15, 0), 0x3fb950, 0.16));
    ridgeY = eavesY + 0.25;
  } else if (roofShape === 'quatre_pans' || roofShape === 'croupe') {
    const penteRad = penteDeg * Math.PI / 180;
    const rise = roofHalfSpan * Math.tan(penteRad);
    ridgeY = eavesY + rise;
    const ridgeLen = Math.max(0.6, W - D);
    const ov = roofOverhang;
    const NW = [-(W / 2 + ov), eavesY, -(D / 2 + ov)], NE = [(W / 2 + ov), eavesY, -(D / 2 + ov)];
    const SW = [-(W / 2 + ov), eavesY, (D / 2 + ov)], SE = [(W / 2 + ov), eavesY, (D / 2 + ov)];
    const Rw = [-ridgeLen / 2, ridgeY, 0], Re = [ridgeLen / 2, ridgeY, 0];
    registerFill("toiture", addRawPart(zoneGroups.toiture, quadGeo(NW, NE, Re, Rw), 0x3fb950, 0.16));
    registerFill("toiture", addRawPart(zoneGroups.toiture, quadGeo(SE, SW, Rw, Re), 0x3fb950, 0.16));
    registerFill("toiture", addRawPart(zoneGroups.toiture, triGeo(NW, SW, Rw), 0x3fb950, 0.16));
    registerFill("toiture", addRawPart(zoneGroups.toiture, triGeo(SE, NE, Re), 0x3fb950, 0.16));
  } else {
    const penteRad = penteDeg * Math.PI / 180;
    const rise = roofHalfSpan * Math.tan(penteRad);
    ridgeY = eavesY + rise;
    const roofSlopeLength = Math.sqrt(roofHalfSpan * roofHalfSpan + rise * rise);
    const roofAngle = Math.atan2(rise, roofHalfSpan);
    function makeSlope(sign) {
      const geo = new THREE.BoxGeometry(W + 0.7, 0.12, roofSlopeLength);
      const mesh = new THREE.Mesh(geo, makeFillMat(0x3fb950, 0.16));
      mesh.rotation.x = sign * roofAngle;
      mesh.position.set(0, (eavesY + ridgeY) / 2, sign * (roofHalfSpan / 2));
      zoneGroups.toiture.add(mesh);
      const wire = new THREE.LineSegments(new THREE.EdgesGeometry(geo), makeWireMat());
      wire.rotation.copy(mesh.rotation); wire.position.copy(mesh.position);
      zoneGroups.toiture.add(wire);
      return mesh;
    }
    registerFill("toiture", makeSlope(1));
    registerFill("toiture", makeSlope(-1));
    function makeGable(zSide) {
      const halfW = W / 2;
      const geo = triGeo([-halfW, eavesY, zSide], [halfW, eavesY, zSide], [0, ridgeY, zSide]);
      registerFill("toiture", addRawPart(zoneGroups.toiture, geo, 0x3fb950, 0.16));
    }
    makeGable(-D / 2); makeGable(D / 2);
  }

  const decor = new THREE.Group(); house.add(decor);
  function addDecorPanel(geometry, position, rotationY) {
    const fill = new THREE.Mesh(geometry, makeFillMat(0x5fb2ff, 0.22));
    fill.position.copy(position); if (rotationY) fill.rotation.y = rotationY;
    decor.add(fill);
    const wire = new THREE.LineSegments(new THREE.EdgesGeometry(geometry), makeWireMat());
    wire.position.copy(position); if (rotationY) wire.rotation.y = rotationY;
    decor.add(wire);
  }
  for (let i = 0; i < floors; i++) {
    const y = wallsStartY + i * levelH + levelH / 2;
    [-W * 0.22, W * 0.22].forEach(x => addDecorPanel(new THREE.BoxGeometry(0.9, levelH * 0.42, 0.06), new THREE.Vector3(x, y, D / 2 + 0.02)));
  }
  addDecorPanel(new THREE.BoxGeometry(0.9, 1.9, 0.06), new THREE.Vector3(0, wallsStartY - 0.3 + 1.0, D / 2 + 0.02));
  if (hasBasement) {
    [-W * 0.28, W * 0.28].forEach(x => addDecorPanel(new THREE.BoxGeometry(0.6, 0.35, 0.06), new THREE.Vector3(x, basementTopY - 0.25, D / 2 + 0.16)));
  }
  if (hasGarage) {
    const garageW = 3.0, garageD = 4.2, garageH = 2.4;
    let gx = 0, gz = 0;
    if (garagePos === 'ouest') { gx = -W / 2 - garageW / 2 - 0.05; }
    else if (garagePos === 'est') { gx = W / 2 + garageW / 2 + 0.05; }
    else if (garagePos === 'nord') { gz = -D / 2 - garageD / 2 - 0.05; }
    else { gz = D / 2 + garageD / 2 + 0.05; }
    addDecorPanel(new THREE.BoxGeometry(garageW, garageH, garageD), new THREE.Vector3(gx, wallsStartY - 0.3 + garageH / 2, gz));
    addDecorPanel(new THREE.BoxGeometry(garageW + 0.3, 0.1, garageD + 0.3), new THREE.Vector3(gx, wallsStartY - 0.3 + garageH + 0.05, gz));
  }
  if (hasGarden) {
    const side = hasGarage && (garagePos === 'ouest') ? 1 : -1;
    const size = Math.sqrt(clamp(g.garden_surface_m2 ?? 100, 20, 2000));
    const gardenGeo = new THREE.PlaneGeometry(size, size);
    const gardenMat = new THREE.MeshBasicMaterial({ color: 0x3fb950, transparent: true, opacity: 0.08, side: THREE.DoubleSide });
    const gardenMesh = new THREE.Mesh(gardenGeo, gardenMat);
    gardenMesh.rotation.x = -Math.PI / 2;
    gardenMesh.position.set(side * (W / 2 + size / 2 + 1.2), 0.02, 0);
    house.add(gardenMesh);
  }

  house.rotation.y = orientationDeg * Math.PI / 180;

  houseDims = { W, D, floors, levelH, wallsStartY, eavesY, ridgeY, basementCenterY, fondY };
}

function clamp(v, min, max) { return Math.max(min, Math.min(max, v)); }
function quadGeo(a, b, c, d) {
  const geo = new THREE.BufferGeometry();
  const verts = new Float32Array([...a, ...b, ...c, ...a, ...c, ...d]);
  geo.setAttribute('position', new THREE.BufferAttribute(verts, 3));
  return geo;
}
function triGeo(a, b, c) {
  const geo = new THREE.BufferGeometry();
  const verts = new Float32Array([...a, ...b, ...c]);
  geo.setAttribute('position', new THREE.BufferAttribute(verts, 3));
  return geo;
}

// ---------- 5. EFFETS VISUELS PILOTÉS PAR LE RISQUE ----------
function buildEffectMeshes() {
  const { W, D, fondY, basementCenterY, bounds } = houseDims;
  // En mode emprise reelle, le bati n'est pas centre sur l'origine : les
  // effets doivent se caler sur ses bornes, pas sur ±W/2.
  const centreX = bounds ? (bounds.minX + bounds.maxX) / 2 : 0;
  const faceSudZ = bounds ? bounds.maxZ : D / 2;

  const crackGeo = new THREE.PlaneGeometry(W * 0.8, 0.5);
  const crackMat = new THREE.MeshBasicMaterial({ map: crackTextures[1], transparent: true, opacity: 0, depthWrite: false });
  crackMesh = new THREE.Mesh(crackGeo, crackMat);
  crackMesh.position.set(centreX, fondY, faceSudZ + 0.22);
  house.add(crackMesh);

  const waterGeo = new THREE.CircleGeometry(Math.max(W, D) * 0.9, 48);
  const waterMat = new THREE.MeshBasicMaterial({ color: 0x2fa9ff, transparent: true, opacity: 0.32, side: THREE.DoubleSide, depthWrite: false });
  waterMesh = new THREE.Mesh(waterGeo, waterMat);
  waterMesh.rotation.x = -Math.PI / 2;
  waterMesh.position.x = centreX;
  waterMesh.position.z = bounds ? (bounds.minZ + bounds.maxZ) / 2 : 0;
  waterMesh.position.y = basementCenterY - 5;
  waterMesh.userData.baseY = basementCenterY;
  waterMesh.userData.targetRatio = 0;
  house.add(waterMesh);

  stainMeshes = {};
  const wallY = houseDims.wallsStartY + houseDims.levelH / 2;
  const stainDefs = {
    murs_nord: { pos: new THREE.Vector3(centreX, wallY, (bounds ? bounds.minZ : -D / 2) - 0.03), rot: 0 },
    murs_sud:  { pos: new THREE.Vector3(centreX, wallY, (bounds ? bounds.maxZ : D / 2) + 0.03), rot: 0 },
    murs_est:  { pos: new THREE.Vector3((bounds ? bounds.maxX : W / 2) + 0.03, wallY, 0), rot: Math.PI / 2 },
    murs_ouest:{ pos: new THREE.Vector3((bounds ? bounds.minX : -W / 2) - 0.03, wallY, 0), rot: Math.PI / 2 }
  };
  Object.entries(stainDefs).forEach(([zone, def]) => {
    const geo = new THREE.PlaneGeometry(1.6, 1.6);
    const mat = new THREE.MeshBasicMaterial({ map: stainTexture, transparent: true, opacity: 0, depthWrite: false });
    const mesh = new THREE.Mesh(geo, mat);
    // Sur une emprise reelle, la façade retenue est celle effectivement
    // construite pour cette orientation : l'aureole se colle dessus, avec
    // sa vraie normale, plutot que sur une face de boite qui n'existe pas.
    const ancre = zoneAnchors[zone];
    if (ancre) {
      mesh.position.copy(ancre.position).addScaledVector(ancre.normal, 0.04);
      mesh.lookAt(mesh.position.clone().add(ancre.normal));
    } else {
      mesh.position.copy(def.pos); mesh.rotation.y = def.rot;
    }
    house.add(mesh);
    stainMeshes[zone] = mesh;
  });
}

function applyZoneEffect(zoneName, score) {
  const effect = mapRiskToEffect(zoneName, score);
  if (zoneName === "fondations" && crackMesh) {
    crackMesh.material.opacity = effect.crackOpacity || 0;
    crackMesh.material.map = crackTextures[Math.max(1, effect.crackLayers || 1)];
    crackMesh.material.needsUpdate = true;
  }
  if (zoneName === "sous_sol" && waterMesh) {
    waterMesh.userData.targetRatio = effect.waterHeightRatio || 0;
  }
  if (zoneName.startsWith("murs_") && stainMeshes[zoneName]) {
    stainMeshes[zoneName].material.opacity = effect.humidityOpacity || 0;
  }
}

const maxWaterRise = 2.4;
function animateEffects(dt, elapsed) {
  if (waterMesh) {
    const target = waterMesh.userData.baseY + waterMesh.userData.targetRatio * maxWaterRise;
    const bob = waterMesh.userData.targetRatio > 0.01 ? Math.sin(elapsed * 1.4) * 0.04 : 0;
    const hiddenY = waterMesh.userData.baseY - 5;
    const wantedY = waterMesh.userData.targetRatio > 0.01 ? target + bob : hiddenY;
    waterMesh.position.y += (wantedY - waterMesh.position.y) * 0.08;
  }
}

// ---------- 6. SCORE -> COULEUR + LABELS ----------
function scoreToColor(score) {
  if (score < 30) return 0x3fb950;
  if (score < 60) return 0xd29922;
  if (score < 80) return 0xdb6d28;
  return 0xda3633;
}
const ROOF_WEAR_COLOR = new THREE.Color(0x8a5a2b);
function animateColor(mesh, targetHex, duration = 500) {
  const mat = mesh.material;
  const startColor = mat.color.clone();
  const targetColor = new THREE.Color(targetHex);
  const startTime = performance.now();
  function step(now) {
    const t = Math.min((now - startTime) / duration, 1);
    mat.color.lerpColors(startColor, targetColor, t < 0.5 ? 2 * t * t : -1 + (4 - 2 * t) * t);
    if (t < 1) requestAnimationFrame(step);
  }
  requestAnimationFrame(step);
}
function updateZoneColor(zoneName, score, animated = true) {
  const meshes = zoneFillMeshes[zoneName];
  if (!meshes || !meshes.length) return;
  let color = new THREE.Color(scoreToColor(score));
  if (zoneName === 'toiture') {
    const wear = mapRiskToEffect('toiture', score).tileWear || 0;
    color = color.clone().lerp(ROOF_WEAR_COLOR, wear * 0.7);
  }
  const targetHex = color.getHex();
  meshes.forEach(m => animated ? animateColor(m, targetHex) : m.material.color.set(targetHex));
  updateZoneLabel(zoneName, score);
  applyZoneEffect(zoneName, score);
}

function buildLabels() {
  const { W, D, wallsStartY, levelH, floors, ridgeY, basementCenterY, bounds } = houseDims;
  const topY = wallsStartY + floors * levelH;
  const minX = bounds ? bounds.minX : -W / 2, maxX = bounds ? bounds.maxX : W / 2;
  const minZ = bounds ? bounds.minZ : -D / 2, maxZ = bounds ? bounds.maxZ : D / 2;
  const centreX = (minX + maxX) / 2, centreZ = (minZ + maxZ) / 2;
  const anchors = {
    fondations: new THREE.Vector3(maxX + 0.3, houseDims.fondY, maxZ + 0.3),
    murs_nord:  new THREE.Vector3(centreX, topY - levelH / 2, minZ),
    murs_sud:   new THREE.Vector3(centreX, topY - levelH / 2, maxZ),
    murs_est:   new THREE.Vector3(maxX, wallsStartY + levelH / 2, centreZ),
    murs_ouest: new THREE.Vector3(minX, wallsStartY + levelH / 2, centreZ),
    toiture:    new THREE.Vector3(centreX, ridgeY, centreZ),
    sous_sol:   new THREE.Vector3(minX - 0.3, basementCenterY, maxZ + 0.3)
  };
  // Sur une emprise reelle, on accroche l'etiquette de façade au mur
  // effectivement construit pour cette orientation (le milieu geometrique
  // peut tomber dans le vide, par exemple dans le creux d'un L).
  Object.keys(zoneAnchors).forEach(zone => {
    if (anchors[zone]) anchors[zone] = zoneAnchors[zone].position.clone().setY(anchors[zone].y);
  });
  const offsets = {
    fondations: new THREE.Vector3(1.8, 0.6, 1.8), murs_nord: new THREE.Vector3(0, 1.6, -1.4),
    murs_sud: new THREE.Vector3(0, 1.6, 1.4), murs_est: new THREE.Vector3(2.4, 1.2, 0),
    murs_ouest: new THREE.Vector3(-2.4, 1.2, 0), toiture: new THREE.Vector3(0, 1.6, 0),
    sous_sol: new THREE.Vector3(-1.8, 0.3, 1.8)
  };
  ZONE_NAMES.forEach(name => {
    const texture = makeLabelCanvasTexture(name, 0);
    const material = new THREE.SpriteMaterial({ map: texture, transparent: true, depthTest: false });
    const sprite = new THREE.Sprite(material);
    const anchor = anchors[name].clone().add(offsets[name]);
    sprite.position.copy(anchor); sprite.scale.set(1.8, 0.55, 1);
    house.add(sprite); labelSprites[name] = sprite;
    const lineGeo = new THREE.BufferGeometry().setFromPoints([anchors[name], anchor]);
    const line = new THREE.Line(lineGeo, new THREE.LineBasicMaterial({ color: WIRE_COLOR, transparent: true, opacity: 0.5 }));
    house.add(line); leaderLines[name] = line;
  });
}
function makeLabelCanvasTexture(title, score) {
  const canvas = document.createElement('canvas'); canvas.width = 300; canvas.height = 90;
  const ctx = canvas.getContext('2d');
  const color = '#' + scoreToColor(score).toString(16).padStart(6, '0');
  ctx.fillStyle = 'rgba(10,16,26,0.9)'; ctx.strokeStyle = color; ctx.lineWidth = 3;
  roundRect(ctx, 4, 4, canvas.width - 8, canvas.height - 8, 12); ctx.fill(); ctx.stroke();
  ctx.fillStyle = '#cfe4ff'; ctx.font = '600 22px Segoe UI, sans-serif';
  ctx.fillText(title.replace('_', ' '), 20, 36);
  ctx.fillStyle = color; ctx.font = '700 26px Segoe UI, sans-serif';
  ctx.fillText(score + ' / 100', 20, 70);
  return new THREE.CanvasTexture(canvas);
}
function roundRect(ctx, x, y, w, h, r) {
  ctx.beginPath(); ctx.moveTo(x + r, y);
  ctx.arcTo(x + w, y, x + w, y + h, r); ctx.arcTo(x + w, y + h, x, y + h, r);
  ctx.arcTo(x, y + h, x, y, r); ctx.arcTo(x, y, x + w, y, r); ctx.closePath();
}
function updateZoneLabel(zoneName, score) {
  const sprite = labelSprites[zoneName]; if (!sprite) return;
  sprite.material.map = makeLabelCanvasTexture(zoneName, score);
  sprite.material.needsUpdate = true;
}

// ---------- 7. CONTRÔLE CAMÉRA (glisser = tourner, molette = zoom) ----------
const cameraTarget = new THREE.Vector3(0, 2.2, 0);
let radius = 17, theta = Math.PI / 4, phi = Math.PI / 3;
let targetTheta = theta, targetPhi = phi, targetRadius = radius;
let isDragging = false, lastX = 0, lastY = 0, idleTime = 0;

function updateCameraPosition(dt) {
  if (!isDragging) { idleTime += dt; if (idleTime > 2) targetTheta += dt * 0.05; }
  theta += (targetTheta - theta) * 0.1; phi += (targetPhi - phi) * 0.1; radius += (targetRadius - radius) * 0.1;
  camera.position.x = cameraTarget.x + radius * Math.sin(phi) * Math.sin(theta);
  camera.position.y = cameraTarget.y + radius * Math.cos(phi);
  camera.position.z = cameraTarget.z + radius * Math.sin(phi) * Math.cos(theta);
  camera.lookAt(cameraTarget);
}
renderer.domElement.addEventListener('mousedown', e => { isDragging = true; idleTime = 0; lastX = e.clientX; lastY = e.clientY; });
window.addEventListener('mouseup', () => { isDragging = false; idleTime = 0; });
window.addEventListener('mousemove', e => {
  if (!isDragging) return;
  const dx = e.clientX - lastX, dy = e.clientY - lastY; lastX = e.clientX; lastY = e.clientY;
  targetTheta -= dx * 0.006; targetPhi = Math.max(0.35, Math.min(Math.PI / 2.1, targetPhi - dy * 0.006));
});
renderer.domElement.addEventListener('wheel', e => { e.preventDefault(); targetRadius = Math.max(6, Math.min(140, targetRadius + e.deltaY * 0.01)); }, { passive: false });
function fitCameraToHouse() {
  const span = Math.max(houseDims.W || 8, houseDims.D || 8);
  const hauteur = houseDims.ridgeY || 6;
  // Un immeuble de 5 niveaux sur 40 m d'emprise ne tenait pas dans le cadrage
  // prevu pour une maison : la distance suit desormais la plus grande des
  // deux dimensions, emprise ou hauteur.
  const fit = clamp(Math.max(span * 1.9, hauteur * 2.4), 12, 110);
  radius = fit; targetRadius = fit;
  // Le brouillard etait fige a 20/55 unites, calibre pour une maison vue de
  // 17 unites. Sur un immeuble de 40 m recule a 110 unites, tout le bati
  // tombait au-dela de la distance de disparition et virait a la couleur de
  // fond : d'ou l'impression de ne plus rien voir. Les distances suivent
  // desormais le cadrage.
  if (scene.fog) { scene.fog.near = fit * 1.15; scene.fog.far = fit * 3.2; }

  // Grille et cercle de scan sont dimensionnes pour une maison : sur un
  // immeuble, la grille s'arretait sous le bati et l'anneau disparaissait a
  // l'interieur. Les deux suivent maintenant l'emprise.
  const echelleSol = clamp(span / 14, 1, 6);
  grid.scale.setScalar(echelleSol);
  scanRing.scale.setScalar(echelleSol);

  const b = houseDims.bounds;
  if (b) {
    const cx = (b.minX + b.maxX) / 2, cz = (b.minZ + b.maxZ) / 2;
    grid.position.set(cx, 0, cz);
    scanRing.position.set(cx, 0.01, cz);
  }
  cameraTarget.set(
    b ? (b.minX + b.maxX) / 2 : 0,
    Math.max(2.2, hauteur * 0.45),
    b ? (b.minZ + b.maxZ) / 2 : 0
  );
}

// ---------- 8. RAYCASTING (survol + clic) ----------
const raycaster = new THREE.Raycaster();
const mouse = new THREE.Vector2();
let hoveredGroup = null;
function getIntersects(event) {
  mouse.x = (event.clientX / window.innerWidth) * 2 - 1;
  mouse.y = -(event.clientY / window.innerHeight) * 2 + 1;
  raycaster.setFromCamera(mouse, camera);
  return raycaster.intersectObjects(interactiveMeshes);
}
renderer.domElement.addEventListener('mousemove', event => {
  if (isDragging) return;
  const intersects = getIntersects(event);
  const newGroup = intersects.length ? intersects[0].object.parent : null;
  if (hoveredGroup && hoveredGroup !== newGroup) { hoveredGroup.scale.set(1, 1, 1); hoveredGroup = null; renderer.domElement.style.cursor = 'grab'; }
  if (newGroup && newGroup !== hoveredGroup) { hoveredGroup = newGroup; hoveredGroup.scale.set(1.02, 1.02, 1.02); renderer.domElement.style.cursor = 'pointer'; }
});
renderer.domElement.addEventListener('click', event => {
  const intersects = getIntersects(event);
  if (intersects.length) showZonePanel(intersects[0].object.userData.zoneName);
});

// ---------- 9. ÉTAT APPLICATIF ----------
let rawData = null;
let currentZones = null;
let currentYear = 2025;

function loadDataset(data) {
  rawData = data;
  buildHouse(data.geometry);
  fitCameraToHouse();
  document.getElementById('addr-line').textContent = data.adresse || '—';
  const climat = data.climat;
  const climPanel = document.getElementById('climat-panel');
  if (climat && climat['2050']) {
    const p2050 = climat['2050'];
    // Le pic absolu (temperature_max_projetee_c = temperature_max_absolue_c de l'API) a la priorite
    const picTemp = p2050.temperature_max_projetee_c;
    if (typeof picTemp === 'number') {
      document.getElementById('temp-value').textContent = picTemp.toFixed(1) + ' °C';
    } else if (typeof p2050.temperature_max_moyenne_c === 'number') {
      document.getElementById('temp-value').textContent = p2050.temperature_max_moyenne_c.toFixed(1) + ' °C (moy.)';
    }
    if (typeof p2050.precipitation_annuelle_moyenne_mm === 'number') {
      document.getElementById('precip-value').textContent = p2050.precipitation_annuelle_moyenne_mm.toFixed(0) + ' mm/an';
    } else {
      document.getElementById('precip-value').textContent = 'N/C';
    }
    if (typeof p2050.jours_chaleur_extreme_par_an === 'number') {
      document.getElementById('canicule-value').textContent = p2050.jours_chaleur_extreme_par_an.toFixed(1) + ' j/an';
    } else {
      document.getElementById('canicule-value').textContent = 'N/C';
    }
    document.getElementById('climat-sources-badge').textContent = climat.source || 'source —';
    climPanel.style.display = 'block';
    climPanel.style.marginTop = '10px';
    climPanel.style.paddingTop = '10px';
    climPanel.style.borderTop = '1px solid #E7DED6';
    climPanel.style.fontSize = '12px';
    climPanel.style.color = '#7C8791';
    climPanel.style.lineHeight = '1.5';
  }

  // Badges sources conditionnelles
  if (data._sources && data._sources.climat_copernicus) {
    document.getElementById('copernicus-badge').style.display = 'block';
  }
  if (data.marche && data.marche.dvf_disponible) {
    document.getElementById('dvf-badge').style.display = 'block';
  }
  document.getElementById('info-panel').style.display = 'none';
  setYear(2025, true);
}

function setYear(year, force) {
  if (year === currentYear && !force) return;
  currentYear = year;
  document.getElementById('btn-2025').classList.toggle('active', year === 2025);
  document.getElementById('btn-2050').classList.toggle('active', year === 2050);
  const source = year === 2050 ? rawData.projection_2050.zones : rawData.zones;
  const scoreGlobal = year === 2050 ? rawData.projection_2050.score_global : rawData.score_global;
  currentZones = JSON.parse(JSON.stringify(source));
  document.getElementById('score-value').textContent = scoreGlobal;
  window.currentGlobalScore = scoreGlobal;
  ZONE_NAMES.forEach(name => { if (currentZones[name]) updateZoneColor(name, currentZones[name].risque, !force); });
  const infoPanel = document.getElementById('info-panel');
  if (infoPanel.style.display === 'block' && infoPanel.dataset.zone) showZonePanel(infoPanel.dataset.zone);
}
document.getElementById('btn-2025').addEventListener('click', () => setYear(2025));
document.getElementById('btn-2050').addEventListener('click', () => setYear(2050));

// Echappe le texte libre produit par le LLM avant insertion via innerHTML.
function escapeHtml(str) {
  if (str === null || str === undefined) return '';
  return String(str)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');
}

// Construit la phrase "coût estimé" complète à partir de l'objet
// cout_estime produit par l'agent recommandations : montant_min/max/devise/unite
// + infos de contexte (date_estimation, zone_geo, hypotheses).
function formatCoutEstime(cout) {
  if (!cout || (cout.montant_min == null && cout.montant_max == null)) return null;
  const min = cout.montant_min, max = cout.montant_max, dev = cout.devise || '€';
  const range = (min != null && max != null && min !== max) ? `entre ${min} et ${max}` : `environ ${min ?? max}`;
  let txt = `💶 <b>Coût estimé : ${range} ${escapeHtml(dev)}</b>${cout.unite ? ' ' + escapeHtml(cout.unite) : ''}`;
  const contexte = [];
  if (cout.zone_geo) contexte.push(escapeHtml(cout.zone_geo));
  if (cout.date_estimation) contexte.push(`estimation ${escapeHtml(cout.date_estimation)}`);
  if (contexte.length) txt += ` <span class="reco-meta-sub">(${contexte.join(', ')})</span>`;
  if (cout.hypotheses) txt += `<div class="reco-meta-sub">Hypothèses : ${escapeHtml(cout.hypotheses)}</div>`;
  return txt;
}

// Helpers partagés (chat + devis) pour lire indifféremment le schéma réel
// (mesure/cout_estime objet/aide/sources) et le schéma d'exemple
// (travaux/cout_estime chaîne/gain_resilience).
function recoLabel(r) { return r.mesure || r.travaux || 'Travaux recommandés'; }
function recoCostRange(r) {
  const c = r.cout_estime;
  if (c && typeof c === 'object') {
    const min = c.montant_min, max = c.montant_max;
    if (min == null && max == null) return { min: 0, max: 0, label: '—' };
    const dev = c.devise || '€';
    const label = (min != null && max != null && min !== max) ? `${min}–${max} ${dev}` : `environ ${min ?? max} ${dev}`;
    return { min: min ?? max ?? 0, max: max ?? min ?? 0, label };
  }
  if (typeof c === 'string') {
    const parts = c.replace(/€/g, '').split('-').map(n => parseInt(n, 10));
    if (parts.length === 2 && !isNaN(parts[0]) && !isNaN(parts[1])) return { min: parts[0], max: parts[1], label: c };
    return { min: 0, max: 0, label: c || '—' };
  }
  return { min: 0, max: 0, label: '—' };
}
function recoGain(r) { return typeof r.gain_resilience === 'number' ? r.gain_resilience : 10; }

function showZonePanel(zoneName) {
  const data = currentZones[zoneName]; if (!data) return;
  const panel = document.getElementById('info-panel');
  panel.style.display = 'block'; panel.dataset.zone = zoneName;

  // ---- Build zone tabs ----
  const tabsContainer = document.getElementById('info-zone-tabs');
  tabsContainer.innerHTML = '';
  const zoneNames = Object.keys(currentZones);
  zoneNames.forEach(z => {
    const zData = currentZones[z];
    const tab = document.createElement('span');
    tab.className = 'info-zone-tab' + ((z === zoneName) ? ' active' : '');
    if (!zData.recommandations || !zData.recommandations.length) tab.classList.add('tab-empty');
    const label = z.replace(/_/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
    const n = (zData.recommandations || []).length;
    tab.innerHTML = label + (n > 0 ? '<span class="tab-count">' + n + '</span>' : '');
    tab.onclick = () => showZonePanel(z);
    tabsContainer.appendChild(tab);
  });

  // ---- Zone header ----
  document.getElementById('info-title').textContent = zoneName.replace(/_/g, ' ');
  const badge = document.getElementById('info-badge');
  badge.textContent = data.niveau.toUpperCase() + ' \u2014 ' + data.risque + '/100';
  badge.style.background = '#' + scoreToColor(data.risque).toString(16).padStart(6, '0');
  document.getElementById('info-alea').innerHTML = '<b>Al\u00e9a :</b> ' + escapeHtml(data.alea_principal);
  document.getElementById('info-justif').textContent = data.justification;

  // ---- Diagnostic compact ----
  const conclusionDiv = document.getElementById('info-conclusion');
  const diagnosticHeader = document.getElementById('info-diagnostic-header');
  const etatDiv = document.getElementById('info-etat');
  const aggravantsDiv = document.getElementById('info-aggravants');
  const attenuantsDiv = document.getElementById('info-attenuants');
  if (data.conclusion) {
    let zoneLabel = zoneName.replace(/_/g, ' ').replace(/\b\w/g, function(c) { return c.toUpperCase(); });
    diagnosticHeader.textContent = 'Diagnostic ' + zoneLabel;
    etatDiv.textContent = 'Etat : ' + data.conclusion;
    conclusionDiv.style.display = 'block';
    aggravantsDiv.innerHTML = '';
    if (data.facteurs_aggravants && data.facteurs_aggravants.length) {
      let h = '<div style="font-size:10.5px;font-weight:600;color:#C0392B;margin-bottom:3px;">Aggravants</div><div style="font-size:11px;color:#4B5760;line-height:1.5;">';
      for (let i = 0; i < data.facteurs_aggravants.length; i++) {
        h += '<div style="display:flex;align-items:flex-start;gap:5px;margin-bottom:2px;"><span style="color:#C0392B;flex-shrink:0;">\u2022</span><span>' + escapeHtml(data.facteurs_aggravants[i]) + '</span></div>';
      }
      h += '</div>';
      aggravantsDiv.innerHTML = h;
    }
    attenuantsDiv.innerHTML = '';
    if (data.facteurs_attenuants && data.facteurs_attenuants.length) {
      let h = '<div style="font-size:10.5px;font-weight:600;color:#1F9D6C;margin-bottom:3px;">Att\u00e9nuants</div><div style="font-size:11px;color:#4B5760;line-height:1.5;">';
      for (let j = 0; j < data.facteurs_attenuants.length; j++) {
        h += '<div style="display:flex;align-items:flex-start;gap:5px;margin-bottom:2px;"><span style="color:#1F9D6C;flex-shrink:0;">\u2022</span><span>' + escapeHtml(data.facteurs_attenuants[j]) + '</span></div>';
      }
      h += '</div>';
      attenuantsDiv.innerHTML = h;
    }
  } else {
    conclusionDiv.style.display = 'none';
  }

  // ---- Cost summary ----
  const costSummary = document.getElementById('info-cost-summary');
  const recos = data.recommandations || [];
  let totalMin = 0, totalMax = 0, aideTotal = 0;
  recos.forEach(r => {
    const c = parseCoutEstime(r.cout_estime);
    if (c.min > 0) totalMin += c.min;
    if (c.max > 0) totalMax += c.max;
    if (r.aide && r.aide.dispositif) aideTotal += c.min * 0.3;
  });
  if (totalMin > 0 || totalMax > 0) {
    document.getElementById('cs-total').textContent = totalMin.toLocaleString('fr-FR') + ' \u2014 ' + totalMax.toLocaleString('fr-FR') + ' \u20ac';
    document.getElementById('cs-aides').textContent = '~' + Math.round(aideTotal).toLocaleString('fr-FR') + ' \u20ac';
    const reste = totalMin - aideTotal;
    document.getElementById('cs-reste').textContent = Math.max(0, reste).toLocaleString('fr-FR') + ' \u20ac';
    const pct = totalMax > 0 ? Math.min(100, Math.round((aideTotal / totalMax) * 100)) : 0;
    document.getElementById('cs-progress').style.width = pct + '%';
    costSummary.classList.add('visible');
  } else {
    costSummary.classList.remove('visible');
  }

  // ---- Recommendations (accordion cards) ----
  const recosDiv = document.getElementById('info-recos');
  recosDiv.innerHTML = '';

  if (!recos.length) {
    const empty = document.createElement('div');
    empty.className = 'reco-empty';
    empty.textContent = 'Aucune recommandation pour cette zone.';
    recosDiv.appendChild(empty);
    return;
  }

  recos.forEach((r, index) => {
    const card = document.createElement('div');
    card.className = 'reco-card';

    const mesure = r.mesure || r.travaux || 'Travaux recommand\u00e9s';
    const risqueConcerne = r.risque_concerne || (Array.isArray(r.sources) && r.sources.length ? r.sources[0].source_id : '') || '';
    const cout = parseCoutEstime(r.cout_estime);

    // Priority badge based on risk level
    const niveau = data.niveau || 'modere';
    let priorite = 'moyenne';
    let prioriteLabel = 'Moyenne';
    if (niveau === 'critique' || niveau === 'eleve') { priorite = 'haute'; prioriteLabel = 'Haute'; }
    else if (niveau === 'faible') { priorite = 'faible'; prioriteLabel = 'Faible'; }

    const coutLabel = cout.min > 0 || cout.max > 0
      ? cout.label
      : (typeof r.cout_estime === 'string' ? r.cout_estime : '');

    card.innerHTML = '<div class="reco-card-header" onclick="toggleRecoCard(this)">'
      + '<svg class="reco-chevron" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 4l4 4-4 4"/></svg>'
      + '<div class="reco-title-wrap"><span class="reco-title">' + escapeHtml(mesure) + '</span>'
      + (coutLabel ? '<span class="reco-sub">' + escapeHtml(coutLabel) + '</span>' : '')
      + '</div>'
      + '<span class="reco-priority-badge ' + priorite + '">' + prioriteLabel + '</span>'
      + '</div>'
      + '<div class="reco-card-body">'
      + (risqueConcerne ? '<div class="reco-risque-tag">' + escapeHtml(risqueConcerne) + '</div>' : '')
      + (r.explication ? '<div class="reco-explication">' + escapeHtml(r.explication) + '</div>' : '')
      + (r.type ? '<div class="reco-meta"><strong>Type :</strong> ' + escapeHtml(r.type.replace(/_/g, ' ')) + '</div>' : '')
      + (coutLabel ? '<div class="reco-meta"><strong>Cout estime :</strong> ' + escapeHtml(coutLabel) + '</div>' : '')
      + (r.gain_resilience ? '<div class="reco-meta"><strong>Gain resilience :</strong> +' + r.gain_resilience + '</div>' : '')
      + (r.aide && (r.aide.dispositif || r.aide.conditions) ? '<div class="reco-aide">\U0001f3db\ufe0f <b>' + escapeHtml(r.aide.dispositif || 'Aide potentielle') + '</b>'
        + (r.aide.conditions ? '<div style="font-size:11px;color:#8A5A10;margin-top:3px;">' + escapeHtml(r.aide.conditions) + '</div>' : '')
        + (r.aide.statut ? '<div style="font-size:10px;color:#B96A18;margin-top:2px;">Statut : ' + escapeHtml(r.aide.statut.replace(/_/g, ' ')) + '</div>' : '')
        + '</div>' : '')
      + (Array.isArray(r.sources) && r.sources.length ? '<div class="reco-sources">Sources : ' + r.sources.map(s => s.source_id || s.fiche_id).filter(Boolean).join(', ') + '</div>' : '')
      + '</div>';

    recosDiv.appendChild(card);
  });
}

function toggleRecoCard(header) {
  const body = header.nextElementSibling;
  const chevron = header.querySelector('.reco-chevron');
  if (body) body.classList.toggle('open');
  if (chevron) chevron.classList.toggle('open');
}

function parseCoutEstime(c) {
  if (!c) return { min: 0, max: 0, label: '\u2014' };
  if (typeof c === 'string') {
    const parts = c.split('-');
    if (parts.length === 2 && !isNaN(parts[0]) && !isNaN(parts[1])) return { min: parseInt(parts[0]), max: parseInt(parts[1]), label: c };
    return { min: 0, max: 0, label: c };
  }
  if (typeof c === 'object') {
    const min = parseInt(c.montant_min) || 0;
    const max = parseInt(c.montant_max) || 0;
    return { min, max, label: (min || max) ? (min + ' \u2014 ' + max + ' \u20ac') : '\u2014' };
  }
  return { min: 0, max: 0, label: '\u2014' };
}
// ---------- 10. BOUCLE DE RENDU ----------
let lastTime = performance.now();
function animate(now) {
  requestAnimationFrame(animate);
  const dt = Math.min((now - lastTime) / 1000, 0.1); lastTime = now;
  const elapsed = now / 1000;
  updateCameraPosition(dt);
  animateEffects(dt, elapsed);
  renderer.render(scene, camera);
}
requestAnimationFrame(animate);

window.addEventListener('resize', () => {
  camera.aspect = window.innerWidth / window.innerHeight; camera.updateProjectionMatrix();
  renderer.setSize(window.innerWidth, window.innerHeight);
});

// ---------- 11. DÉMARRAGE ----------
loadDataset(DEFAULT_DATA);
</script>

<script>
/* =========================================================================
   ORCHESTRATION — accueil -> formulaire -> traitement (appel réel au
   backend /diagnostic) -> jumeau 3D. Le mode "prospection par zone/ville"
   reste ici un aperçu front (voir commentaire sur #zone-overlay) : son
   backend sera branché plus tard par un autre développeur.
   ========================================================================= */
(function () {
  const homeScreen = document.getElementById('home-screen');
  const formScreen = document.getElementById('form-screen');
  const loadingScreen = document.getElementById('loading-screen');
  const appUI = document.getElementById('app-ui');
  const form = document.getElementById('property-form');
  const steps = Array.from(document.querySelectorAll('#loading-steps .step'));
  const barFill = document.getElementById('loading-bar-fill');
  const loadingError = document.getElementById('loading-error');
  const loadingErrorMsg = document.getElementById('loading-error-msg');
  const loadingRetryBtn = document.getElementById('loading-retry-btn');
  const jsonInput = document.getElementById('json-input');
  const demoDataBtn = document.getElementById('demo-data-btn');
  const brandWatermark = document.getElementById('brand-watermark');

  let stepTimers = [];

  function openDiagnosticForm() {
    homeScreen.style.display = 'none';
    formScreen.style.display = 'flex';
    formScreen.scrollTop = 0;
  }

  // ==================== CARTE INTERACTIVE ZONE (simplifiée + heatmap) ====================
  const ZONE_BACKEND = 'http://localhost:8000';
  const zoneOverlay = document.getElementById('zone-overlay');
  const zoneCloseBtn = document.getElementById('zone-close-btn');
  const zoneResults = document.getElementById('zone-results');
  const zoneAssessBtn = document.getElementById('zone-assess-btn');
  const zoneCoordsInfo = document.getElementById('zone-coords-info');
  const zoneLoading = document.getElementById('zone-loading');
  const zoneLoadingFill = zoneLoading.querySelector('.zone-loading-fill');
  const zoneLoadingText = zoneLoading.querySelector('.zone-loading-text');
  const zoneCityInput = document.getElementById('zone-city-input');
  const zoneSuggestions = document.getElementById('zone-suggestions');
  const zoneAutorefineToggle = document.getElementById('zone-autorefine-toggle');
  const zoneRefineStatus = document.getElementById('zone-refine-status');
  const zonePrecisionBadge = document.getElementById('zone-precision-badge');

  let zoneMap = null;
  let zoneBounds = null;
  let selectedCity = null;
  let banTimeout = null;

  // ---- Raffinement au zoom/pan ----
  let hasFirstResult = false;   // n'active l'auto-raffinement qu'après la 1ère analyse explicite
  let moveDebounce = null;      // timer de debounce sur moveend
  let requestSeq = 0;           // compteur pour ignorer les réponses obsolètes (zoom rapide)
  let activeController = null;  // AbortController de la requête en cours

  // Palier de finesse de grille en fonction du niveau de zoom : plus on zoome,
  // plus spacing_km diminue -> plus de points -> plus de précision locale.
  function spacingForZoom(zoom) {
    if (zoom < 11) return 1.2;
    if (zoom < 13) return 0.6;
    if (zoom < 15) return 0.3;
    return 0.15;
  }

  // Calcule spacing_km + max_points en s'assurant que la grille rectangulaire
  // (mêmes formules que _generer_grille_rectangulaire côté backend) tient
  // entière dans la limite de l'API (max_points <= 200) : sinon le backend
  // tronque la grille à mi-ligne et les isobandes de turf cassent.
  function computeGridParams(bounds, targetSpacingKm) {
    const [latMin, lonMin, latMax, lonMax] = bounds;
    const latMoy = (latMin + latMax) / 2;
    const degPerKmLat = 1.0 / 111.0;
    const degPerKmLon = 1.0 / (111.0 * Math.cos(latMoy * Math.PI / 180));
    let spacing = targetSpacingKm;
    let rows, cols, total;
    for (let i = 0; i < 20; i++) {
      const stepLat = spacing * degPerKmLat;
      const stepLon = spacing * degPerKmLon;
      rows = Math.floor((latMax - latMin) / stepLat) + 1;
      cols = Math.floor((lonMax - lonMin) / stepLon) + 1;
      total = rows * cols;
      if (total <= 195) break;
      spacing *= 1.15; // trop de points -> grille plus lâche
    }
    return { spacingKm: spacing, maxPoints: Math.min(200, total + 2), rows, cols };
  }

  const PERIL_NAMES = {
    inondation: { fr: 'Inondation', emoji: '🌊' },
    rga: { fr: 'RGA (Argiles)', emoji: '🧱' },
    tempete: { fr: 'Tempête', emoji: '💨' },
    incendie: { fr: 'Incendie', emoji: '🔥' },
    seisme: { fr: 'Séisme', emoji: '🌋' }
  };

  // === BAN Geocoding — toutes les villes de France ===
  async function searchCity(query) {
    if (query.length < 2) { zoneSuggestions.innerHTML = ''; return; }
    try {
      const resp = await fetch(`https://api-adresse.data.gouv.fr/search/?q=${encodeURIComponent(query)}&type=municipality&limit=6`);
      const data = await resp.json();
      zoneSuggestions.innerHTML = '';
      data.features.forEach(f => {
        const city = f.properties.city || f.properties.name;
        const ctx = f.properties.context || '';
        const div = document.createElement('div');
        div.className = 'ban-suggestion';
        div.textContent = `${city} — ${ctx}`;
        div.onclick = () => selectCity({
          label: `${city} (${ctx.split(',')[0] || ''})`,
          lat: f.geometry.coordinates[1],
          lon: f.geometry.coordinates[0],
          city: city,
          citycode: f.properties.citycode || ''
        });
        zoneSuggestions.appendChild(div);
      });
    } catch (e) { /* silencieux */ }
  }

  function selectCity(city) {
    selectedCity = city;
    zoneCityInput.value = city.label || city.city;
    zoneSuggestions.innerHTML = '';
    const lat = city.lat, lon = city.lon;
    const d = 0.025;
    zoneBounds = { lat_min: lat - d, lon_min: lon - d, lat_max: lat + d, lon_max: lon + d };
    zoneAssessBtn.disabled = false;
    zoneCoordsInfo.textContent = `${city.city} — ${lat.toFixed(4)}°N, ${lon.toFixed(4)}°E`;
    zoneMap.flyTo({ center: [lon, lat], zoom: 13, duration: 1200 });
  }

  function initZoneMap() {
    if (zoneMap) return;
    zoneMap = new maplibregl.Map({
      container: 'zone-map',
      style: 'https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json',
      center: [2.35, 48.85], // Paris — toute la France
      zoom: 5
    });
    zoneMap.addControl(new maplibregl.NavigationControl(), 'bottom-right');
    zoneMap.addControl(new maplibregl.ScaleControl({ unit: 'metric' }));

    zoneMap.on('load', () => {
      // Source des points d'échantillonnage (garde les points bruts, utile
      // pour debug/inspection au clic, mais n'est plus l'aplat visuel principal)
      zoneMap.addSource('sample-points', { type: 'geojson', data: { type: 'FeatureCollection', features: [] } });

      // AVANT : gros cercles translucides qui se chevauchaient pour simuler un aplat.
      // MAINTENANT : vraies isobandes (turf.isobands) calculées sur la grille régulière
      // renvoyée par le backend -> polygones lissés par palier de risque, comme une
      // carte d'étages bioclimatiques. Voir buildIsobands().
      zoneMap.addSource('risk-isobands', { type: 'geojson', data: { type: 'FeatureCollection', features: [] } });
      zoneMap.addLayer({
        id: 'risk-isobands-fill',
        type: 'fill',
        source: 'risk-isobands',
        paint: {
          'fill-color': ['get', 'fillColor'],
          'fill-opacity': 0.55
        }
      });
      // Fine frontière entre bandes pour une lecture nette (façon carte imprimée)
      zoneMap.addLayer({
        id: 'risk-isobands-line',
        type: 'line',
        source: 'risk-isobands',
        paint: { 'line-color': 'rgba(255,255,255,0.25)', 'line-width': 0.5 }
      });

      // Points individuels par-dessus : uniquement visibles en zoomant sur la ville,
      // servent de repère précis (l'échantillon exact que le backend a scoré)
      zoneMap.addLayer({
        id: 'sample-dots',
        type: 'circle',
        source: 'sample-points',
        minzoom: 13,
        paint: {
          'circle-radius': ['interpolate', ['linear'], ['zoom'],
            13, 1.5,
            15, 2.5,
            17, 3.5,
            18, 5
          ],
          'circle-color': [
            'step', ['get', 'score'],
            '#1F9D6C',
            20, '#5ADB8A',
            40, '#F5C542',
            60, '#E27B2E',
            80, '#C0392B'
          ],
          'circle-opacity': 0.85,
          'circle-stroke-color': '#fff',
          'circle-stroke-width': 1
        }
      });

      // ---- Annonces "en vente" (données réelles uniquement : DVF ou base
      // CSV locale, cf. backend /diagnostic/zone/annonces) : marqueurs
      // clusterisés colorés par score climatique, façon dvfexplorer.fr. ----
      zoneMap.addSource('annonces', {
        type: 'geojson',
        data: { type: 'FeatureCollection', features: [] },
        cluster: true,
        clusterMaxZoom: 15,
        clusterRadius: 50
      });
      zoneMap.addLayer({
        id: 'annonces-clusters',
        type: 'circle',
        source: 'annonces',
        filter: ['has', 'point_count'],
        paint: {
          'circle-radius': ['step', ['get', 'point_count'], 14, 10, 18, 30, 24],
          'circle-color': '#1E2A33',
          'circle-stroke-color': '#fff',
          'circle-stroke-width': 2
        }
      });
      zoneMap.addLayer({
        id: 'annonces-cluster-count',
        type: 'symbol',
        source: 'annonces',
        filter: ['has', 'point_count'],
        layout: {
          'text-field': ['get', 'point_count_abbreviated'],
          'text-font': ['Open Sans Bold'],
          'text-size': 12
        },
        paint: { 'text-color': '#fff' }
      });
      zoneMap.addLayer({
        id: 'annonces-unclustered',
        type: 'circle',
        source: 'annonces',
        filter: ['!', ['has', 'point_count']],
        paint: {
          'circle-radius': 7,
          'circle-color': [
            'step', ['get', 'climat_score'],
            '#1F9D6C',
            20, '#5ADB8A',
            40, '#F5C542',
            60, '#E27B2E',
            80, '#C0392B'
          ],
          'circle-stroke-color': '#fff',
          'circle-stroke-width': 1.5
        }
      });

      zoneMap.on('mouseenter', 'annonces-unclustered', () => { zoneMap.getCanvas().style.cursor = 'pointer'; });
      zoneMap.on('mouseleave', 'annonces-unclustered', () => { zoneMap.getCanvas().style.cursor = ''; });
      zoneMap.on('mouseenter', 'annonces-clusters', () => { zoneMap.getCanvas().style.cursor = 'pointer'; });
      zoneMap.on('mouseleave', 'annonces-clusters', () => { zoneMap.getCanvas().style.cursor = ''; });

      // Clic sur un cluster -> zoom pour l'éclater (comportement standard MapLibre)
      zoneMap.on('click', 'annonces-clusters', (e) => {
        const features = zoneMap.queryRenderedFeatures(e.point, { layers: ['annonces-clusters'] });
        const clusterId = features[0].properties.cluster_id;
        zoneMap.getSource('annonces').getClusterExpansionZoom(clusterId, (err, zoom) => {
          if (err) return;
          zoneMap.easeTo({ center: features[0].geometry.coordinates, zoom });
        });
      });

      // Clic sur une annonce individuelle -> popup façon fiche DVF Explorer
      zoneMap.on('click', 'annonces-unclustered', (e) => {
        const f = e.features[0];
        showAnnoncePopup(f.geometry.coordinates.slice(), f.properties);
      });
    });

    // ---- Auto-raffinement : à chaque zoom/pan terminé, on relance une
    // évaluation sur la zone visible avec une grille adaptée au niveau de zoom.
    zoneMap.on('moveend', () => {
      if (!hasFirstResult || !zoneAutorefineToggle.checked) return;
      clearTimeout(moveDebounce);
      moveDebounce = setTimeout(runAutoRefine, 550);
    });
  }

  // Construit les isobandes (aplats lissés) à partir de la grille de points
  // scorés. RISK_BREAKS/RISK_COLORS reprennent exactement les seuils déjà
  // utilisés pour les scores individuels (faible/modéré/élevé/critique).
  const RISK_BREAKS = [0, 20, 40, 60, 80, 100.01];
  const RISK_COLORS = ['#1F9D6C', '#5ADB8A', '#F5C542', '#E27B2E', '#C0392B'];

  function buildIsobands(points) {
    // points: [{lat, lon, score}], doit former une grille rectangulaire complète
    // (voir computeGridParams) sinon turf.isobands peut produire un résultat vide.
    if (!window.turf || points.length < 4) return { type: 'FeatureCollection', features: [] };
    try {
      const fc = turf.featureCollection(
        points.map(p => turf.point([p.lon, p.lat], { score: p.score }))
      );
      const bands = turf.isobands(fc, RISK_BREAKS, { zProperty: 'score' });
      bands.features.forEach((f, i) => {
        f.properties.fillColor = RISK_COLORS[Math.min(i, RISK_COLORS.length - 1)];
      });
      return bands;
    } catch (e) {
      console.warn('isobands: grille insuffisante pour lisser (', e.message, ')');
      return { type: 'FeatureCollection', features: [] };
    }
  }

  function openZoneExplorer() {
    zoneOverlay.classList.add('open');
    zoneOverlay.setAttribute('aria-hidden', 'false');
    zoneResults.classList.remove('visible');
    setTimeout(() => {
      initZoneMap();
      zoneMap.resize();
    }, 250);
  }

  function closeZoneExplorer() {
    zoneOverlay.classList.remove('open');
    zoneOverlay.setAttribute('aria-hidden', 'true');
  }

  // === Autocomplete BAN pour la recherche de ville ===
  zoneCityInput.oninput = () => {
    clearTimeout(banTimeout);
    const q = zoneCityInput.value.trim();
    if (q.length < 2) { zoneSuggestions.innerHTML = ''; return; }
    banTimeout = setTimeout(() => searchCity(q), 250);
  };
  zoneCityInput.onblur = () => {
    setTimeout(() => { zoneSuggestions.innerHTML = ''; }, 200);
  };
  zoneCityInput.onkeydown = (e) => {
    if (e.key === 'Enter' && zoneSuggestions.children.length > 0) {
      zoneSuggestions.children[0].click();
    }
  };

  // === Cœur unique d'appel au backend, partagé par le bouton "Analyser" et
  // par l'auto-raffinement au zoom/pan. `opts.silent` évite de rejouer toute
  // l'animation de chargement à chaque pan (juste un petit badge discret).
  async function runAssessment(boundsArr, spacingKm, maxPoints, opts = {}) {
    const seq = ++requestSeq;
    if (activeController) activeController.abort();
    activeController = new AbortController();

    if (opts.silent) {
      zoneRefineStatus.classList.add('visible');
    } else {
      zoneAssessBtn.disabled = true;
      zoneLoading.classList.add('visible');
      zoneLoadingFill.style.width = '30%';
      zoneLoadingText.textContent = 'Appel au backend Typhoon…';
      zoneResults.classList.remove('visible');
    }

    try {
      const response = await fetch(`${ZONE_BACKEND}/diagnostic/zone`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          bounds: boundsArr,
          spacing_km: spacingKm,
          max_points: maxPoints,
          land_only: false
        }),
        signal: activeController.signal
      });

      if (!response.ok) {
        const errText = await response.text();
        throw new Error(`Erreur ${response.status}: ${errText}`);
      }
      const data = await response.json();

      // Une réponse plus lente arrivée après une plus récente (zoom rapide) : on jette.
      if (seq !== requestSeq) return;

      if (!opts.silent) {
        zoneLoadingFill.style.width = '100%';
        zoneLoadingText.textContent = 'Terminé ✓';
      }
      displayZoneResults(data, opts);
      hasFirstResult = true;
    } catch (err) {
      if (err.name === 'AbortError') return; // requête remplacée, rien à signaler
      if (opts.silent) {
        console.warn('auto-raffinement: échec silencieux —', err.message);
      } else {
        zoneLoadingText.textContent = 'Erreur: ' + err.message;
        zoneAssessBtn.disabled = false;
        setTimeout(() => zoneLoading.classList.remove('visible'), 3000);
      }
    } finally {
      if (seq === requestSeq) {
        zoneRefineStatus.classList.remove('visible');
        if (!opts.silent) {
          setTimeout(() => {
            zoneLoading.classList.remove('visible');
            zoneAssessBtn.disabled = false;
          }, 400);
        }
      }
    }
  }

  // === Bouton "Analyser cette ville" : première évaluation explicite ===
  zoneAssessBtn.onclick = () => {
    if (!zoneBounds) return;
    const boundsArr = [zoneBounds.lat_min, zoneBounds.lon_min, zoneBounds.lat_max, zoneBounds.lon_max];
    const { spacingKm, maxPoints } = computeGridParams(boundsArr, 0.3);
    runAssessment(boundsArr, spacingKm, maxPoints, { silent: false });
    fetchZonePrix(boundsArr);
    fetchZoneAnnonces(boundsArr);
  };

  // === Auto-raffinement : rejoue l'évaluation sur la zone VISIBLE du zoom
  // courant, avec une grille adaptée (plus fine en zoomant, cf. spacingForZoom) ===
  function runAutoRefine() {
    if (!zoneMap) return;
    const b = zoneMap.getBounds();
    const zoom = zoneMap.getZoom();
    const boundsArr = [b.getSouth(), b.getWest(), b.getNorth(), b.getEast()];
    const target = spacingForZoom(zoom);
    const { spacingKm, maxPoints } = computeGridParams(boundsArr, target);
    zonePrecisionBadge.textContent = `zoom ${zoom.toFixed(1)} · grille ${Math.round(spacingKm * 1000)} m`;
    runAssessment(boundsArr, spacingKm, maxPoints, { silent: true });
    fetchZonePrix(boundsArr);
    fetchZoneAnnonces(boundsArr);
  }

  // === DVF : prix au m2 de la zone visible (ventes réelles, cf. panneau
  // "Marché immobilier" de la sidebar). Endpoint séparé de /diagnostic/zone
  // (climat) car source de données différente (CSV DVF local par
  // département, pas toujours présent sur le poste — voir settings.dvf_enabled
  // côté backend et data/lookup/dvf/README.md). ===
  let prixRequestSeq = 0;

  async function fetchZonePrix(boundsArr) {
    const seq = ++prixRequestSeq;
    if (!selectedCity || !selectedCity.citycode) {
      displayZonePrix({ disponible: false, message: 'Ville sans code INSEE connu — impossible de déterminer le département DVF.' });
      return;
    }
    try {
      const resp = await fetch(`${ZONE_BACKEND}/diagnostic/zone/prix`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ bounds: boundsArr, citycode: selectedCity.citycode })
      });
      if (!resp.ok) throw new Error(`Erreur ${resp.status}`);
      const data = await resp.json();
      if (seq !== prixRequestSeq) return; // réponse obsolète (pan rapide)
      displayZonePrix(data);
    } catch (e) {
      if (seq !== prixRequestSeq) return;
      displayZonePrix({ disponible: false, message: 'Backend DVF injoignable.' });
    }
  }

  function displayZonePrix(data) {
    const medianEl = document.getElementById('zm-prix-median');
    const metaEl = document.getElementById('zm-prix-meta');
    if (!data || !data.disponible) {
      medianEl.textContent = '—';
      metaEl.textContent = (data && data.message) || 'Données DVF indisponibles sur ce poste.';
      return;
    }
    if (!data.nb_ventes) {
      medianEl.textContent = '—';
      metaEl.textContent = 'Aucune vente DVF trouvée dans cette zone (département ' + data.departement + ').';
      return;
    }
    medianEl.textContent = Math.round(data.prix_m2_median).toLocaleString('fr-FR') + ' €/m²';
    const parType = Object.entries(data.par_type || {})
      .map(([type, s]) => `${type} : ${Math.round(s.prix_m2_median).toLocaleString('fr-FR')} €/m² (${s.nb_ventes})`)
      .join(' · ');
    metaEl.textContent = `${data.nb_ventes} vente(s) DVF dans la zone` + (parType ? ' — ' + parType : '');
  }

  // === Annonces "en vente" (marqueurs clusterisés, cf. sources/layers
  // 'annonces' définies dans initZoneMap). Endpoint séparé de DVF (ventes
  // passées) : /diagnostic/zone/annonces ne renvoie que des données réelles
  // (DVF ou base CSV locale d'annonces) — liste vide si aucune des deux
  // n'est disponible, jamais de données fabriquées. ===
  let annoncesRequestSeq = 0;
  const DPE_COLORS = { A: '#0FA860', B: '#4CB944', C: '#A6C93B', D: '#F2C94C', E: '#E8912D', F: '#DE5B33', G: '#C0392B' };

  async function fetchZoneAnnonces(boundsArr) {
    const seq = ++annoncesRequestSeq;
    try {
      const resp = await fetch(`${ZONE_BACKEND}/diagnostic/zone/annonces`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          bounds: boundsArr,
          citycode: (selectedCity && selectedCity.citycode) || null,
          // 200 = plafond backend (voir ZoneAnnoncesRequest) : la base
          // d'annonces (CSV local, cf. annonces_lookup.py) couvre toute la
          // France, donc plus on en récupère, plus il y a de chances d'en
          // voir dans la zone affichée.
          max_results: 200
        })
      });
      if (!resp.ok) throw new Error(`Erreur ${resp.status}`);
      const data = await resp.json();
      if (seq !== annoncesRequestSeq) return; // réponse obsolète (pan rapide)
      displayZoneAnnonces(data);
    } catch (e) {
      if (seq !== annoncesRequestSeq) return;
      console.warn('annonces: échec silencieux —', e.message);
    }
  }

  function displayZoneAnnonces(data) {
    const badge = document.getElementById('zone-annonces-badge');
    const source = zoneMap && zoneMap.getSource('annonces');
    if (!data || !data.disponible || !source) {
      if (badge) badge.classList.remove('visible');
      return;
    }

    // Filet de sécurité : n'affiche jamais un bien de démonstration, même si
    // une réponse mise en cache ou un ancien appel en contiendrait encore.
    const features = (data.listings || [])
      .filter(l => l.lat != null && l.lon != null && l.source !== 'demo')
      .map(l => ({
        type: 'Feature',
        geometry: { type: 'Point', coordinates: [l.lon, l.lat] },
        properties: l
      }));
    source.setData({ type: 'FeatureCollection', features });

    const count = features.length;
    if (count === 0) {
      badge.textContent = `Aucune offre réelle disponible pour cette zone`;
    } else if (data.source === 'dvf') {
      badge.textContent = `✅ ${count} vente(s) DVF réelle(s)`;
    } else if (data.source === 'csv') {
      badge.textContent = `🏠 ${count} maison(s) à vendre (PAP.fr)`;
    } else {
      badge.textContent = `🏠 ${count} bien(s) en vente`;
    }
    badge.classList.add('visible');
  }

  function showAnnoncePopup(coords, p) {
    const dpeColor = DPE_COLORS[p.dpe] || '#8B959D';
    const prixTxt = p.prix != null ? Math.round(p.prix).toLocaleString('fr-FR') + ' €' : '—';
    const surfaceTxt = p.surface_m2 != null ? Math.round(p.surface_m2) + ' m²' : '—';
    const prixM2Txt = p.prix_m2 != null ? Math.round(p.prix_m2).toLocaleString('fr-FR') + ' €' : '—';
    const [lon, lat] = coords;

    const photoHtml = p.photo ? `<img src="${escapeHtml(p.photo)}" alt="" class="annonce-popup-photo" loading="lazy" onerror="this.remove()">` : '';

    const html = `
      ${photoHtml}
      <div class="annonce-popup-title">${escapeHtml(p.adresse || 'Bien immobilier')}</div>
      <div class="annonce-popup-row"><span class="apr-label">Prix</span><span class="apr-value">${prixTxt}</span></div>
      <div class="annonce-popup-row"><span class="apr-label">Surface</span><span class="apr-value">${surfaceTxt}</span></div>
      <div class="annonce-popup-row"><span class="apr-label">Prix/m²</span><span class="apr-value" style="color:#DC4B39;">${prixM2Txt}</span></div>
      <div class="annonce-popup-row"><span class="apr-label">Type</span><span class="apr-value">${escapeHtml(p.type_bien || '—')}</span></div>
      <div class="annonce-popup-row"><span class="apr-label">Date</span><span class="apr-value">${escapeHtml(p.date_publication || '—')}</span></div>
      <div class="annonce-popup-row"><span class="apr-label">Pièces</span><span class="apr-value">${p.pieces ?? '—'}</span></div>
      <div class="annonce-popup-row"><span class="apr-label">DPE</span><span class="apr-value"><span class="annonce-popup-dpe" style="background:${dpeColor}">${escapeHtml(p.dpe || '?')}</span></span></div>
      <div class="annonce-popup-row"><span class="apr-label">Score climat</span><span class="apr-value">${p.climat_score ?? '—'}/100</span></div>
      <div class="annonce-popup-actions">
        ${p.url ? `<a href="${escapeHtml(p.url)}" target="_blank" rel="noopener">Voir l'annonce</a>` : ''}
        <a href="https://www.google.com/maps?layer=c&cbll=${lat},${lon}" target="_blank" rel="noopener">Street View</a>
        <a href="https://www.google.com/maps?q=${lat},${lon}" target="_blank" rel="noopener">Carte</a>
      </div>
      ${p.source === 'dvf' ? '<div class="annonce-popup-tag">Vente DVF réelle (transaction déjà réalisée) — pas une annonce active.</div>' : ''}
    `;

    new maplibregl.Popup({ className: 'annonce-popup', closeButton: true, maxWidth: '260px' })
      .setLngLat(coords)
      .setHTML(html)
      .addTo(zoneMap);
  }

  zoneAutorefineToggle.onchange = () => {
    if (zoneAutorefineToggle.checked && hasFirstResult) runAutoRefine();
  };

  // Légende "Aléas de la zone" (coin haut-gauche de la carte, cf. zone-legend-perils
  // dans le HTML) : reprend les mêmes 5 aléas que le détail sidebar (zmPerils),
  // mais en lecture rapide sur la carte elle-même, triés du plus au moins sévère.
  function updatePerilsLegend(perils) {
    const box = document.getElementById('zone-legend-perils');
    const rows = document.getElementById('zone-legend-perils-rows');
    if (!perils || !Object.keys(perils).length) {
      box.style.display = 'none';
      return;
    }
    const entries = Object.entries(perils)
      .map(([key, p]) => ({ key, moyenne: p.moyenne || 0 }))
      .sort((a, b) => b.moyenne - a.moyenne);

    rows.innerHTML = '';
    entries.forEach(({ key, moyenne }) => {
      const info = PERIL_NAMES[key] || { fr: key, emoji: '📊' };
      const color = moyenne < 20 ? '#1F9D6C' : moyenne < 45 ? '#D98A2B' : moyenne < 70 ? '#E24E2E' : '#C0392B';
      const row = document.createElement('div');
      row.className = 'zone-legend-peril-row';
      row.innerHTML = `
        <span class="plabel"><span class="pdot" style="background:${color}"></span>${info.emoji} ${info.fr}</span>
        <span class="pscore" style="color:${color}">${Math.round(moyenne)}</span>
      `;
      rows.appendChild(row);
    });
    box.style.display = 'block';
  }

  function displayZoneResults(data, opts = {}) {
    zoneResults.classList.add('visible');

    const zmScore = document.getElementById('zm-score');
    const zmBadge = document.getElementById('zm-badge');
    const zmMeta = document.getElementById('zm-meta');
    const zmWorst = document.getElementById('zm-worst');
    const zmWorstPeril = document.getElementById('zm-worst-peril');
    const zmWorstScore = document.getElementById('zm-worst-score');
    const zmPerils = document.getElementById('zm-perils');
    const zmSampleInfo = document.getElementById('zone-sample-info');

    zmScore.textContent = data.score_moyen != null ? Math.round(data.score_moyen) : '—';
    zmBadge.textContent = data.rating_global || '—';
    zmBadge.className = 'zone-rating-badge badge-' + (data.rating_global || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    zmMeta.textContent = `${data.nb_points_valides || 0}/${data.nb_points} points valides`;
    zmSampleInfo.textContent = `${data.nb_points} points · ${data.nb_points_valides || 0} valides · ${data.nb_points_erreur || 0} erreurs`;

    if (data.worst_case_score && data.worst_case_score >= 50) {
      zmWorst.style.display = 'block';
      zmWorstPeril.textContent = data.worst_case_peril || '—';
      zmWorstScore.textContent = Math.round(data.worst_case_score);
    } else {
      zmWorst.style.display = 'none';
    }

    zmPerils.innerHTML = '';
    if (data.perils) {
      for (const [key, peril] of Object.entries(data.perils)) {
        const info = PERIL_NAMES[key] || { fr: key, emoji: '📊' };
        const score = peril.moyenne || 0;
        const color = score < 20 ? '#1F9D6C' : score < 45 ? '#D98A2B' : score < 70 ? '#E24E2E' : '#C0392B';
        const div = document.createElement('div');
        div.className = 'zone-peril-item';
        div.innerHTML = `
          <div class="zone-peril-header">
            <span class="zone-peril-name">${info.emoji} ${info.fr}</span>
            <span class="zone-peril-score" style="color:${color}">${Math.round(score)}</span>
          </div>
          <div class="zone-peril-bar"><div class="zone-peril-fill" style="width:${score}%;background:${color}"></div></div>
        `;
        zmPerils.appendChild(div);
      }
    }
    updatePerilsLegend(data.perils);

    // Points bruts (repères précis, visibles à partir du zoom 13)
    const ptsSource = zoneMap && zoneMap.getSource('sample-points');
    const validPoints = (data.points_echantillon || [])
      .filter(p => p.lat != null && p.lon != null)
      .map(p => ({ lat: p.lat, lon: p.lon, score: p.score ? p.score.score_global : 50 }));

    if (ptsSource) {
      const features = validPoints.map(p => ({
        type: 'Feature',
        geometry: { type: 'Point', coordinates: [p.lon, p.lat] },
        properties: { score: p.score }
      }));
      ptsSource.setData({ type: 'FeatureCollection', features });
    }

    // Isobandes : l'aplat coloré principal, recalculé à chaque évaluation
    // (initiale ou auto-raffinée) sur la grille de points reçue.
    const isoSource = zoneMap && zoneMap.getSource('risk-isobands');
    if (isoSource) {
      isoSource.setData(buildIsobands(validPoints));
    }
  }

  const verifyAddrBtn = document.getElementById('home-cta-mode-a');
  if (verifyAddrBtn) verifyAddrBtn.addEventListener('click', openDiagnosticForm);

  const exploreZoneBtn = document.getElementById('home-cta-mode-b');
  if (exploreZoneBtn) exploreZoneBtn.addEventListener('click', openZoneExplorer);

  zoneCloseBtn.addEventListener('click', closeZoneExplorer);
  zoneOverlay.addEventListener('click', function (e) {
    if (e.target === zoneOverlay) closeZoneExplorer();
  });
  window.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && zoneOverlay.classList.contains('open')) closeZoneExplorer();
  });

  if (brandWatermark) {
    brandWatermark.addEventListener('click', function () { location.reload(); });
  }

  function clearStepTimers() {
    stepTimers.forEach(id => clearTimeout(id));
    stepTimers = [];
  }

  function resetSteps() {
    steps.forEach(s => s.classList.remove('active', 'done'));
    barFill.style.width = '0%';
    loadingError.classList.remove('show');
  }

  // Anime les étapes jusqu'à l'avant-dernière, puis laisse la dernière
  // "active" (en rotation) jusqu'à ce que finishSteps() soit appelé : la
  // durée réelle de l'appel réseau est inconnue, donc l'animation ne doit
  // pas se terminer avant que la réponse soit arrivée.
  function startStepAnimation() {
    resetSteps();
    const delayPerStep = 550;
    const last = steps.length - 1;
    steps.forEach((step, i) => {
      if (i === last) return;
      stepTimers.push(setTimeout(() => {
        steps.forEach(s => s.classList.remove('active'));
        step.classList.add('active');
        barFill.style.width = Math.round(((i + 0.5) / steps.length) * 100) + '%';
      }, i * delayPerStep));
      stepTimers.push(setTimeout(() => {
        step.classList.remove('active');
        step.classList.add('done');
        barFill.style.width = Math.round(((i + 1) / steps.length) * 100) + '%';
      }, i * delayPerStep + delayPerStep - 120));
    });
    stepTimers.push(setTimeout(() => {
      steps[last].classList.add('active');
      barFill.style.width = '92%';
    }, last * delayPerStep));
  }

  function finishSteps(cb) {
    clearStepTimers();
    steps.forEach(s => { s.classList.remove('active'); s.classList.add('done'); });
    barFill.style.width = '100%';
    setTimeout(cb, 350);
  }

  function showLoadingError(message) {
    clearStepTimers();
    loadingErrorMsg.textContent = message;
    loadingError.classList.add('show');
  }

  function showAppUI() {
    loadingScreen.style.display = 'none';
    appUI.classList.add('visible');
    window.dispatchEvent(new Event('resize'));
  }

  function goStraightToTwin(data) {
    // Utilisé par le chargeur de JSON et le bouton "exemple sans backend" :
    // on saute l'appel réseau mais on garde une transition cohérente.
    homeScreen.style.display = 'none';
    formScreen.style.display = 'none';
    loadingScreen.style.display = 'flex';
    resetSteps();
    steps.forEach(s => s.classList.add('done'));
    barFill.style.width = '100%';
    setTimeout(() => {
      loadDataset(data);
      showAppUI();
    }, 500);
  }

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    const adresse = document.getElementById('f-adresse').value.trim();
    if (!adresse) return;
    const apiBase = (document.getElementById('api-base-input').value || 'http://localhost:8000').trim();

    formScreen.style.display = 'none';
    loadingScreen.style.display = 'flex';
    startStepAnimation();

    fetch(apiBase + '/diagnostic', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ adresse }),
    })
      .then(async response => {
        if (!response.ok) {
          const bodyText = await response.text();
          throw new Error(`${response.status} ${response.statusText} — ${bodyText.slice(0, 300)}`);
        }
        return response.json();
      })
      .then(contract => {
        finishSteps(() => {
          loadDataset(contract);
          showAppUI();
        });
      })
      .catch(err => {
        console.error('Échec du diagnostic :', err);
        showLoadingError(`Erreur : ${err.message} — vérifie que le serveur tourne (uvicorn app.main:app) sur ${apiBase} et qu'il est joignable depuis cette page.`);
      });
  });

  loadingRetryBtn.addEventListener('click', function () {
    loadingScreen.style.display = 'none';
    loadingError.classList.remove('show');
    formScreen.style.display = 'flex';
  });

  if (jsonInput) {
    jsonInput.addEventListener('change', function (e) {
      const file = e.target.files[0]; if (!file) return;
      const reader = new FileReader();
      reader.onload = evt => {
        try {
          const data = JSON.parse(evt.target.result);
          goStraightToTwin(data);
        } catch (err) {
          alert('JSON invalide : ' + err.message);
        }
      };
      reader.readAsText(file);
    });
  }

  if (demoDataBtn) {
    demoDataBtn.addEventListener('click', function () { goStraightToTwin(DEFAULT_DATA); });
  }
})();
</script>

<script>
/* =========================================================================
   ASSISTANT IA — CONVERSATION SIMULÉE DANS LE WIDGET DE CHAT
   (100% côté front : aucun appel réseau, réponses générées à partir du
   dataset actuellement affiché — 2025 ou projection 2050)
   ========================================================================= */
(function () {
  const toggleBtn  = document.getElementById('chat-toggle-btn');
  const panel      = document.getElementById('chat-panel');
  const closeBtn   = document.getElementById('chat-close');
  const messagesEl = document.getElementById('chat-messages');
  const inputEl    = document.getElementById('chat-input');
  const sendBtn    = document.getElementById('chat-send');
  const chips      = document.querySelectorAll('#chat-chips .chip');

  let hasGreeted = false;
  let busy = false;

  function scrollToBottom() {
    messagesEl.scrollTop = messagesEl.scrollHeight;
  }

  function addMessage(text, who) {
    const el = document.createElement('div');
    el.className = 'msg ' + who;
    el.textContent = text;
    messagesEl.appendChild(el);
    scrollToBottom();
    return el;
  }

  function showTyping() {
    const el = document.createElement('div');
    el.className = 'msg bot typing';
    el.innerHTML = '<span></span><span></span><span></span>';
    messagesEl.appendChild(el);
    scrollToBottom();
    return el;
  }

  function botReply(getText) {
    busy = true;
    const typingEl = showTyping();
    const delay = 700 + Math.random() * 700;
    setTimeout(() => {
      typingEl.remove();
      addMessage(getText(), 'bot');
      busy = false;
    }, delay);
  }

  function getDataset() {
    return (typeof currentZones !== 'undefined' && currentZones) ? currentZones : DEFAULT_DATA.zones;
  }

  function zoneLabel(name) {
    return name.replace(/_/g, ' ');
  }

  function reponseSynthese() {
    const zones = getDataset();
    const lignes = [];
    Object.keys(zones).forEach(name => {
      (zones[name].recommandations || []).forEach(r => {
        lignes.push(Object.assign({ zone: name }, r));
      });
    });
    if (!lignes.length) {
      return "D'après le diagnostic actuel, aucun travaux urgent n'est identifié sur ce bien.";
    }
    lignes.sort((a, b) => recoGain(b) - recoGain(a));
    let out = "Voici la synthèse des travaux recommandés, classés par gain de résilience estimé :\n\n";
    lignes.forEach((r, i) => {
      out += (i + 1) + ". " + recoLabel(r) + " — " + zoneLabel(r.zone) + "\n";
      out += "   " + recoCostRange(r).label + " · +" + recoGain(r) + "% résilience\n";
    });
    const totalGain = lignes.reduce((s, r) => s + recoGain(r), 0);
    out += "\nEn cumulant ces travaux, le gain de résilience estimé avoisine " + totalGain + "%, ce qui réduirait significativement l'exposition du bien aux sinistres climatiques.";
    return out;
  }

  function reponseRisquePrioritaire() {
    const zones = getDataset();
    let pire = null;
    Object.keys(zones).forEach(name => {
      const z = zones[name];
      if (!pire || z.risque > pire.risque) pire = Object.assign({ name: name }, z);
    });
    if (!pire) return "Aucune zone à risque significatif n'a été détectée sur ce bien.";
    let out = "La zone la plus critique est : " + zoneLabel(pire.name) + " (" + pire.risque + "/100 — niveau " + pire.niveau + ").\n\n";
    out += "Aléa principal : " + pire.alea_principal + ".\n" + pire.justification;
    if (pire.recommandations && pire.recommandations.length) {
      const top = pire.recommandations[0];
      out += "\n\nRecommandation prioritaire : " + recoLabel(top) + " (" + recoCostRange(top).label + "), soit +" + recoGain(top) + "% de résilience.";
    }
    return out;
  }

  function reponseBudget() {
    const zones = getDataset();
    let min = 0, max = 0, count = 0;
    Object.keys(zones).forEach(name => {
      (zones[name].recommandations || []).forEach(r => {
        const cost = recoCostRange(r);
        if (cost.min || cost.max) { min += cost.min; max += cost.max; count++; }
      });
    });
    if (!count) return "Aucun budget travaux n'est nécessaire pour le moment sur ce bien.";
    let out = "Le budget global estimé pour l'ensemble des travaux recommandés se situe entre " + min.toLocaleString('fr-FR') + "€ et " + max.toLocaleString('fr-FR') + "€.\n\n";
    out += "Ce bien pourrait être éligible à certaines aides à la rénovation (MaPrimeRénov', aides locales de prévention des risques naturels) selon la nature exacte des travaux engagés. Je peux vous transmettre un dossier détaillé zone par zone si besoin.";
    return out;
  }

  function reponseDefaut() {
    return "Je peux vous détailler la synthèse des travaux recommandés, le risque le plus prioritaire ou le budget estimé — n'hésitez pas à me le demander, ou cliquez directement sur une zone du jumeau numérique pour son analyse détaillée.";
  }

  const INTENT_RESPONSES = {
    synthese: reponseSynthese,
    risque: reponseRisquePrioritaire,
    budget: reponseBudget
  };

  const INTENT_QUESTIONS = {
    synthese: "Fais-moi une synthèse des recommandations de travaux à réaliser.",
    risque: "Quel est le risque le plus prioritaire sur ce bien ?",
    budget: "Quel budget dois-je prévoir, et y a-t-il des aides disponibles ?"
  };

  function handleUserText(text, forcedResponder) {
    if (busy || !text || !text.trim()) return;
    addMessage(text, 'user');
    inputEl.value = '';

    let responder = forcedResponder;
    if (!responder) {
      const lower = text.toLowerCase();
      if (/synth|recommand|travaux|résumé|resume/.test(lower)) responder = reponseSynthese;
      else if (/risque|priorit|urgent|danger/.test(lower)) responder = reponseRisquePrioritaire;
      else if (/budget|coût|cout|prix|aide|financ/.test(lower)) responder = reponseBudget;
      else responder = reponseDefaut;
    }
    botReply(responder);
  }

  chips.forEach(function (chip) {
    chip.addEventListener('click', function () {
      const intent = chip.dataset.intent;
      handleUserText(INTENT_QUESTIONS[intent] || chip.textContent, INTENT_RESPONSES[intent]);
    });
  });

  sendBtn.addEventListener('click', function () { handleUserText(inputEl.value); });
  inputEl.addEventListener('keydown', function (e) {
    if (e.key === 'Enter') handleUserText(inputEl.value);
  });

  toggleBtn.addEventListener('click', function () {
    panel.classList.toggle('open');
    if (panel.classList.contains('open') && !hasGreeted) {
      hasGreeted = true;
      setTimeout(function () {
        const addr = (typeof rawData !== 'undefined' && rawData && rawData.adresse) ? ' pour le bien situé au ' + rawData.adresse : '';
        addMessage("Bonjour, je suis l'assistant du jumeau numérique" + addr + ". Je peux vous aider à comprendre les risques identifiés sur ce bien et les travaux recommandés. Que souhaitez-vous savoir ?", 'bot');
      }, 400);
    }
  });
  closeBtn.addEventListener('click', function () { panel.classList.remove('open'); });
})();
</script>

<script>
/* =========================================================================
   DEVIS PERSONNALISÉ & CERTIFICATION CLIMATO-RÉSILIENTE
   (100% simulé côté front — calculs indicatifs à partir du dataset affiché ;
   le schéma réel des recommandations n'ayant pas de "gain_resilience"
   numérique par poste de travaux, une valeur par défaut raisonnable est
   utilisée via recoGain() pour garder ce simulateur utilisable.)
   ========================================================================= */
(function () {
  const cta          = document.getElementById('devis-cta');
  const overlay      = document.getElementById('devis-overlay');
  const closeBtn     = document.getElementById('devis-close-btn');
  const listEl       = document.getElementById('devis-list');
  const selectView   = document.getElementById('devis-select-view');
  const resultView   = document.getElementById('devis-result');
  const generateBtn  = document.getElementById('devis-generate-btn');
  const backBtn      = document.getElementById('cert-back-btn');
  const downloadBtn  = document.getElementById('cert-download-btn');

  const sumCount = document.getElementById('sum-count');
  const sumCost  = document.getElementById('sum-cost');
  const sumGain  = document.getElementById('sum-gain');
  const sumPrime = document.getElementById('sum-prime');

  let items = [];

  function zoneLabel(name) { return name.replace(/_/g, ' '); }

  function buildItems() {
    const zones = (typeof currentZones !== 'undefined' && currentZones) ? currentZones : DEFAULT_DATA.zones;
    const out = [];
    Object.keys(zones).forEach(zoneName => {
      (zones[zoneName].recommandations || []).forEach((r, idx) => {
        const cost = recoCostRange(r);
        const label = recoLabel(r);
        out.push({
          id: zoneName + '__' + idx + '__' + label.replace(/[^a-zA-Z0-9]/g, '_'),
          zone: zoneName,
          travaux: label,
          cout_estime: cost.label,
          gain_resilience: recoGain(r),
          min: cost.min, max: cost.max,
          checked: true
        });
      });
    });
    return out;
  }

  function renderList() {
    listEl.innerHTML = '';
    items.forEach(item => {
      const row = document.createElement('label');
      row.className = 'devis-item' + (item.checked ? ' checked' : '');
      row.innerHTML = `
        <input type="checkbox" data-id="${item.id}" ${item.checked ? 'checked' : ''}>
        <div class="devis-item-body">
          <div class="devis-item-title">${item.travaux}</div>
          <div class="devis-item-zone">${zoneLabel(item.zone)}</div>
          <div class="devis-item-meta">${item.cout_estime} · +${item.gain_resilience}% résilience</div>
        </div>`;
      listEl.appendChild(row);
      row.querySelector('input').addEventListener('change', function (e) {
        const it = items.find(i => i.id === e.target.dataset.id);
        it.checked = e.target.checked;
        row.classList.toggle('checked', it.checked);
        updateSummary();
      });
    });
  }

  function computeSelection() {
    const selected = items.filter(i => i.checked);
    const min = selected.reduce((s, i) => s + i.min, 0);
    const max = selected.reduce((s, i) => s + i.max, 0);
    const gain = selected.reduce((s, i) => s + i.gain_resilience, 0);
    return { selected, min, max, gain };
  }

  function computePrime(baseScore, gain) {
    const reduction = Math.max(0, Math.min(baseScore - 10, gain * 0.5));
    const newScore = Math.max(8, Math.round(baseScore - reduction));
    let primePercent = 0;
    if (gain > 0) {
      primePercent = Math.round(((baseScore - newScore) / baseScore) * 60);
      primePercent = Math.max(5, Math.min(30, primePercent));
    }
    return { newScore, primePercent };
  }

  function updateSummary() {
    const { selected, min, max, gain } = computeSelection();
    const baseScore = window.currentGlobalScore ?? DEFAULT_DATA.score_global;
    const { primePercent } = computePrime(baseScore, gain);
    sumCount.textContent = selected.length;
    sumCost.textContent = selected.length ? (min.toLocaleString('fr-FR') + '€ – ' + max.toLocaleString('fr-FR') + '€') : '0€';
    sumGain.textContent = '+' + gain + '%';
    sumPrime.textContent = primePercent + '%';
    generateBtn.disabled = selected.length === 0;
  }

  function openDevis() {
    items = buildItems();
    renderList();
    updateSummary();
    resultView.classList.remove('show');
    selectView.classList.remove('hide');
    overlay.classList.add('open');
  }

  function closeDevis() { overlay.classList.remove('open'); }

  function generateCertificate() {
    const { selected, min, max, gain } = computeSelection();
    const baseScore = window.currentGlobalScore ?? DEFAULT_DATA.score_global;
    const { newScore, primePercent } = computePrime(baseScore, gain);
    const fullyCertified = newScore <= 45;

    document.getElementById('cert-score-before').textContent = baseScore;
    document.getElementById('cert-score-after').textContent = newScore;
    document.getElementById('cert-prime-value').textContent = primePercent + '%';

    const addr = (typeof rawData !== 'undefined' && rawData && rawData.adresse)
      ? rawData.adresse
      : (document.getElementById('f-adresse') ? document.getElementById('f-adresse').value : '—');
    document.getElementById('cert-property').textContent = addr || '—';

    const titleEl = document.getElementById('cert-title');
    const headingEl = document.getElementById('cert-heading');
    const detailEl = document.getElementById('cert-prime-detail');
    const shieldEl = document.getElementById('cert-shield');

    if (fullyCertified) {
      shieldEl.innerHTML = '<svg viewBox="0 0 24 24" width="44" height="44" fill="none" stroke="#1F9D6C" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 4 5v6c0 5 3.5 9 8 11 4.5-2 8-6 8-11V5z"/><path d="m9 12 2 2 4-4"/></svg>';
      titleEl.classList.remove('partial');
      titleEl.textContent = 'Certification Typhoon obtenue';
      headingEl.textContent = 'Bien Climato-Résilient';
      detailEl.textContent = 'Réduction annuelle appliquée à votre cotisation grâce à la baisse durable de votre exposition au risque climatique.';
    } else {
      shieldEl.innerHTML = '<svg viewBox="0 0 24 24" width="44" height="44" fill="none" stroke="#D98A2B" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 4 5v6c0 5 3.5 9 8 11 4.5-2 8-6 8-11V5z"/><path d="M12 8v4l3 2" stroke-dasharray="1 3"/></svg>';
      titleEl.classList.add('partial');
      titleEl.textContent = 'Certification en cours d\'obtention';
      headingEl.textContent = 'Résilience en progression';
      detailEl.textContent = 'Prime provisoire appliquée dès aujourd\'hui. Complétez les travaux restants recommandés pour obtenir la certification complète et la prime maximale.';
    }

    const ul = document.getElementById('cert-works-ul');
    ul.innerHTML = '';
    if (selected.length) {
      selected.forEach(i => {
        const li = document.createElement('li');
        li.innerHTML = `<span>${i.travaux} <em style="color:#FF6B4A;font-style:normal;">— ${zoneLabel(i.zone)}</em></span><span class="cost">${i.cout_estime}</span>`;
        ul.appendChild(li);
      });
      const total = document.createElement('li');
      total.style.borderColor = '#FF6B4A';
      total.innerHTML = `<span><strong>Budget total estimé</strong></span><span class="cost"><strong>${min.toLocaleString('fr-FR')}€ – ${max.toLocaleString('fr-FR')}€</strong></span>`;
      ul.appendChild(total);
    } else {
      ul.innerHTML = '<li>Aucun travaux sélectionné</li>';
    }

    // Persister le resultat du devis dans localStorage pour que la page Property ID
    // puisse le consommer (score apres travaux, prime, certification, travaux retenus).
    // TODO: remplacer par une vraie persistance backend quand le schema recommandations
    // inclura gain_resilience reel.
    try {
      localStorage.setItem('typhoon_devis_result', JSON.stringify({
        score_avant: baseScore,
        score_apres: newScore,
        prime_percent: primePercent,
        certifie: fullyCertified,
        date_generation: new Date().toISOString(),
        adresse: addr,
        travaux_retenus: selected.map(i => ({
          zone: i.zone,
          travaux: i.travaux,
          cout_estime: i.cout_estime,
          gain_resilience: i.gain_resilience,
        })),
      }));
    } catch (e) { /* localStorage peut etre bloque */ }

    selectView.classList.add('hide');
    resultView.classList.add('show');
  }

  cta.addEventListener('click', openDevis);
  closeBtn.addEventListener('click', closeDevis);
  overlay.addEventListener('click', function (e) { if (e.target === overlay) closeDevis(); });
  generateBtn.addEventListener('click', generateCertificate);
  backBtn.addEventListener('click', function () {
    resultView.classList.remove('show');
    selectView.classList.remove('hide');
  });
  downloadBtn.addEventListener('click', function () { window.print(); });

  // Bouton "Voir mon Property ID certifié"
  const propertyIdBtn = document.getElementById('cert-property-id-btn');
  if (propertyIdBtn) {
    propertyIdBtn.addEventListener('click', function () {
      // Lire l'adresse depuis le devis déjà sauvegardé (typhoon_devis_result) plutôt que
      // depuis le DOM — l'ID du champ formulaire (#f-adresse) est différent de #address
      // et le devis contient l'adresse canonique exacte utilisée pour la comparaison
      // dans applyDevisOverrides() côté Property ID.
      try {
        const devisRaw = localStorage.getItem('typhoon_devis_result');
        if (devisRaw) {
          const devisParsed = JSON.parse(devisRaw);
          if (devisParsed && devisParsed.adresse) {
            localStorage.setItem('typhoon_current_address', devisParsed.adresse);
          }
        }
      } catch (e) { /* localStorage peut être bloqué */ }
      // Fermer la modale devis avant d'afficher le Property ID
      // (évite le conflit de z-index : devis=200, Property ID=175)
      if (typeof closeDevis === 'function') closeDevis();
      // Afficher la section Property ID dans la même page (fusion SPA)
      pid_showPropertyID();
    });
  }
})();

/* =====================================================================
   PROPERTY ID — Fonctions fusionnées depuis property-id/index.html
   Utilise les données déjà en mémoire (rawData, currentGlobalScore, etc.)
   au lieu de refaire un appel API séparé.
   ===================================================================== */

const pid_$ = id => document.getElementById(id);

function pid_riskColor(score) {
  if (score <= 25) return '#1F9D6C';
  if (score <= 50) return '#D98A2B';
  if (score <= 75) return '#E24E2E';
  return '#DC4B39';
}

const pid_CERT_LEVELS = {
  Bronze: { primary: '#CD7F32', secondary: '#A0652A', accent: '#E8C88A', label: 'Bronze',
    desc: 'Résilience de base. Des risques significatifs sont identifiés.',
    explain: 'Des travaux de rénovation sont fortement recommandés pour améliorer la résilience du bâtiment face aux risques climatiques.' },
  Silver: { primary: '#A8B8C8', secondary: '#7A8A9A', accent: '#D0DCE8', label: 'Silver',
    desc: 'Résilience satisfaisante. Des risques modérés existent.',
    explain: 'Les risques restent dans des limites acceptables. Des travaux de mitigation sont recommandés pour renforcer le bâtiment.' },
  Gold: { primary: '#D4A017', secondary: '#B8860B', accent: '#F5D76E', label: 'Gold',
    desc: 'Très bonne résilience. Les risques sont faibles et bien gérés.',
    explain: "Ce bâtiment bénéficie d'une très bonne résilience face aux risques climatiques. Les risques sont maîtrisés." },
  Platinum: { primary: '#E5E4E2', secondary: '#B9C2D0', accent: '#FFFFFF', label: 'Platinum',
    desc: 'Résilience exceptionnelle. Risque climatique minimal.',
    explain: 'Ce bâtiment dépasse les normes de construction actuelles. Une référence en matière de résilience et de durabilité.' },
};

function pid_certLevel(score) {
  if (score == null) return '—';
  if (score <= 25) return 'Platinum';
  if (score <= 50) return 'Gold';
  if (score <= 75) return 'Silver';
  return 'Bronze';
}

function pid_renderBadge(container, level, score, pid) {
  const cfg = pid_CERT_LEVELS[level] || pid_CERT_LEVELS.Bronze;
  const isLarge = true;
  const shieldPath = 'M60 5 L110 25 L110 70 C110 105 85 125 60 135 C35 125 10 105 10 70 L10 25 Z';
  const insetPath = 'M60 12 L103 30 L103 68 C103 99 82 117 60 126 C38 117 17 99 17 68 L17 30 Z';
  const gradId = 'pid-bg-' + Date.now();
  const glowId = 'pid-gl-' + Date.now();
  const shineId = 'pid-sh-' + Date.now();

  let svg = `<defs>
    <linearGradient id="${gradId}" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="${cfg.accent}"/>
      <stop offset="40%" stop-color="${cfg.primary}"/>
      <stop offset="100%" stop-color="${cfg.secondary}"/>
    </linearGradient>
    <linearGradient id="${shineId}" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="rgba(255,255,255,0.4)"/>
      <stop offset="50%" stop-color="rgba(255,255,255,0)"/>
      <stop offset="100%" stop-color="rgba(255,255,255,0.08)"/>
    </linearGradient>
    <filter id="${glowId}" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="3" result="blur"/>
      <feComposite in="SourceGraphic" in2="blur" operator="over"/>
    </filter>
  </defs>`;
  svg += `<path d="${shieldPath}" fill="url(#${gradId})" stroke="${cfg.secondary}" stroke-width="2" filter="url(#${glowId})"/>`;
  svg += `<path d="${insetPath}" fill="rgba(255,255,255,0.12)" stroke="rgba(255,255,255,0.3)" stroke-width="1"/>`;
  svg += `<path d="${shieldPath}" fill="url(#${shineId})"/>`;
  svg += '<path d="M51 40 L69 45 L69 62 C69 76 60 84 60 88 C60 84 51 76 51 62 Z" fill="' + cfg.secondary + '" stroke="' + cfg.primary + '" stroke-width="1"/>';
  svg += '<text x="60" y="72" text-anchor="middle" font-family="Inter,system-ui,sans-serif" font-weight="700" font-size="17" fill="' + (level === 'Platinum' ? '#4A5A7A' : '#fff') + '">' + cfg.label + '</text>';
  svg += '<text x="60" y="92" text-anchor="middle" font-family="Inter,system-ui,sans-serif" font-weight="700" font-size="13" fill="rgba(255,255,255,0.85)">' + (score != null ? score : '—') + '/100</text>';
  if (pid) svg += '<text x="60" y="115" text-anchor="middle" font-family="Inter,system-ui,sans-serif" font-weight="600" font-size="8" fill="rgba(255,255,255,0.5)">' + pid + '</text>';
  svg += '<text x="60" y="131" text-anchor="middle" font-family="Inter,system-ui,sans-serif" font-weight="700" font-size="8" fill="#1F9D6C">● VERIFIÉ</text>';
  container.innerHTML = svg;
}

function pid_renderGauge(svgEl, valueEl, score) {
  const oldBg = svgEl.querySelector('.gauge-bg');
  const oldFill = svgEl.querySelector('.gauge-fill');
  if (oldBg) oldBg.remove();
  if (oldFill) oldFill.remove();
  const cx = 60, cy = 60, r = 48;
  const circumference = 2 * Math.PI * r;
  const targetOffset = circumference - (score / 100) * circumference;
  const color = pid_riskColor(score);

  const bg = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
  bg.setAttribute('class', 'gauge-bg');
  bg.setAttribute('cx', cx); bg.setAttribute('cy', cy); bg.setAttribute('r', r);
  svgEl.prepend(bg);

  const fill = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
  fill.setAttribute('class', 'gauge-fill');
  fill.setAttribute('cx', cx); fill.setAttribute('cy', cy); fill.setAttribute('r', r);
  fill.setAttribute('stroke', color);
  fill.setAttribute('stroke-dasharray', circumference);
  fill.setAttribute('stroke-dashoffset', circumference);
  svgEl.appendChild(fill);

  requestAnimationFrame(() => {
    fill.style.transition = 'stroke-dashoffset 0.8s cubic-bezier(0.4, 0, 0.2, 1)';
    fill.setAttribute('stroke-dashoffset', targetOffset);
  });

  valueEl.textContent = score;
  valueEl.style.color = color;
  valueEl.classList.remove('pid-score-pop');
  void valueEl.offsetWidth;
  valueEl.classList.add('pid-score-pop');
}

function pid_fadeIn() {
  document.querySelectorAll('#property-id-screen .pid-fade.vis').forEach(el => el.classList.remove('vis'));
  requestAnimationFrame(() => {
    document.querySelectorAll('#property-id-screen .pid-fade').forEach((el, i) => {
      setTimeout(() => el.classList.add('vis'), i * 60);
    });
  });
}

function pid_renderPropertyID(data) {
  /* Header */
  const pid = data.property_id || '—';
  pid_$('pid-prop-id-label').textContent = 'PROPERTY ID ' + pid;
  const addr = (data.building && data.building.address) || '—';
  pid_$('pid-prop-address').textContent = addr;
  pid_$('pid-addr-line').textContent = '';
  pid_$('pid-prop-date').textContent = data.generated_at
    ? 'Généré le ' + new Date(data.generated_at).toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' })
    : '—';

  /* Certification */
  const cert = data.certification;
  const bdgSvg = pid_$('pid-badge-svg');
  if (cert && cert.level && cert.level !== '—') {
    const level = cert.level;
    const cfg = pid_CERT_LEVELS[level] || pid_CERT_LEVELS.Bronze;
    pid_renderBadge(bdgSvg, level, cert.score, data.property_id);
    pid_$('pid-cert-level').textContent = 'Typhoon ' + cfg.label;
    pid_$('pid-cert-level').className = 'cl ' + level.toLowerCase();
    pid_$('pid-cert-desc').textContent = cfg.desc;
    pid_$('pid-cert-explain').textContent = cfg.explain;
    pid_$('pid-cert-issued').textContent = cert.issued_at ? new Date(cert.issued_at).toLocaleDateString('fr-FR') : '—';
    pid_$('pid-cert-expiry').textContent = cert.expires_at ? new Date(cert.expires_at).toLocaleDateString('fr-FR') : '—';
    pid_$('pid-verif-badge').style.display = 'inline-flex';
    pid_$('pid-cert-score').innerHTML = (cert.score != null ? cert.score : '—') + '<sup>/100</sup>';
    pid_$('pid-cert-pill').style.display = 'inline-flex';
    pid_$('pid-cert-pill').textContent = cfg.label;
    pid_$('pid-cert-pill').className = 'pid-cert-pill ' + level.toLowerCase();
    /* Révéler le contenu et cacher le skeleton */
    pid_$('pid-skel-cert').classList.remove('active');
    pid_$('pid-cert-content').style.display = 'flex';
  } else {
    bdgSvg.innerHTML = '';
    pid_$('pid-cert-level').textContent = 'Aucune certification disponible';
    pid_$('pid-cert-level').className = 'cl pending';
    pid_$('pid-cert-desc').textContent = 'Un diagnostic initial a été réalisé. La certification sera délivrée après validation des travaux recommandés.';
    pid_$('pid-cert-explain').textContent = '';
    pid_$('pid-cert-issued').textContent = '—';
    pid_$('pid-cert-expiry').textContent = '—';
    pid_$('pid-verif-badge').style.display = 'none';
    pid_$('pid-cert-score').textContent = '—';
    pid_$('pid-cert-pill').style.display = 'none';
    /* Révéler le contenu et cacher le skeleton */
    pid_$('pid-skel-cert').classList.remove('active');
    pid_$('pid-cert-content').style.display = 'flex';
  }

  /* Gauges */
  const scores = data.scores || {};
  pid_renderGauge(pid_$('pid-section-gauges').querySelectorAll('.gw svg')[0], pid_$('pid-gauge-ov'), scores.overall || 0);
  pid_renderGauge(pid_$('pid-section-gauges').querySelectorAll('.gw svg')[1], pid_$('pid-gauge-cl'), scores.climate || 0);
  pid_renderGauge(pid_$('pid-section-gauges').querySelectorAll('.gw svg')[2], pid_$('pid-gauge-in'), scores.insurance || 0);

  /* Risk summary */
  const rs = data.risk_summary || {};
  pid_$('pid-risk-highest').textContent = rs.highest_risk || '—';
  const rl = (rs.risk_level || '—').toLowerCase();
  const rb = pid_$('pid-risk-level');
  rb.textContent = rs.risk_level || '—';
  const nl = rl.normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[èéêë]/g, 'e');
  rb.className = 'pid-risk-badge ' + (['faible', 'modere', 'eleve', 'critique'].includes(nl) ? nl : 'na');
  pid_$('pid-risk-hazard').textContent = rs.main_hazard || '—';

  /* Building info */
  const bld = data.building || {};
  function cleanRoof(r) { if (!r) return null; const c = r.replace(/\s*\(None\)\s*/g, '').trim(); return c || null; }
  function fmtNA(val, el) {
    const display = val != null ? String(val) : null;
    el.textContent = display || '—';
    el.className = 'iv' + (display === null ? ' na' : '');
    if (display === null) el.setAttribute('title', "Donnée non disponible pour cette adresse — cela n'affecte pas votre certification.");
    return display;
  }
  fmtNA(bld.construction_year, pid_$('pid-bld-year'));
  fmtNA(bld.building_type, pid_$('pid-bld-type'));
  fmtNA(bld.materials, pid_$('pid-bld-materials'));
  fmtNA(cleanRoof(bld.roof), pid_$('pid-bld-roof'));
  fmtNA(bld.floors, pid_$('pid-bld-floors'));
  pid_$('pid-bld-addr').textContent = bld.address || '—';

  /* Recommendations */
  const recos = data.recommendations || [];
  const recoList = pid_$('pid-reco-list');
  recoList.innerHTML = '';
  if (recos.length === 0) {
    recoList.innerHTML = '<div class="pid-reco-empty"><svg class="ei" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg><p>Aucune recommandation disponible pour cette adresse.</p><p class="eh">Les recommandations de travaux apparaîtront une fois la base documentaire RAG configurée et l\'index généré.</p></div>';
  } else {
    recos.forEach(r => {
      const div = document.createElement('div');
      div.className = 'pid-reco-item';
      const mesure = r.mesure || r.travaux || r.title || 'Travaux recommandés';
      const typeName = r.type || '';
      const zoneName = r.zone ? r.zone.replace(/_/g, ' ') : '';
      const sources = r.sources || [];
      const coutText = r.cout_estime ? (typeof r.cout_estime === 'object' ? r.cout_estime.montant_min || '' : r.cout_estime) : '';
      div.innerHTML = '<svg class="ri" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>'
        + '<div class="rc">'
        + '<div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:4px">'
        + '<div class="rt">' + mesure.slice(0, 120) + (mesure.length > 120 ? '...' : '') + '</div>'
        + (zoneName ? '<span class="pid-zone-badge">' + zoneName + '</span>' : '')
        + (typeName ? '<span class="pid-type-badge">' + typeName.replace(/_/g, ' ') + '</span>' : '')
        + '</div>'
        + (r.explication ? '<div class="rd">' + r.explication.slice(0, 300) + '</div>' : '')
        + '<div class="rm">'
        + (coutText ? '<span>💰 ' + coutText + '</span>' : '')
        + (r.gain_resilience ? '<span>📈 Résilience +' + r.gain_resilience + '</span>' : '')
        + (sources.length > 0 ? '<span>📄 ' + sources.length + ' source(s)</span>' : '')
        + '</div>'
        + (sources.length > 0 ? '<div class="rsrc">Sources : ' + sources.map(s => s.source_id || '').filter(Boolean).join(', ') + '</div>' : '')
        + '</div>';
      recoList.appendChild(div);
    });
  }

  /* Timeline */
  const timeline = data.timeline || [];
  const tl = pid_$('pid-timeline-container');
  tl.innerHTML = '';
  if (timeline.length === 0) {
    tl.innerHTML = '<div class="pid-reco-empty"><p style="font-size:13px">Aucun événement enregistré.</p></div>';
  } else {
    timeline.forEach(evt => {
      const div = document.createElement('div');
      const isCert = evt.event && evt.event.toLowerCase().includes('certification');
      div.className = 'pid-timeline ti' + (isCert ? ' cert' : '');
      const d = evt.date ? new Date(evt.date).toLocaleDateString('fr-FR', { year: 'numeric', month: 'short', day: 'numeric' }) : '—';
      let iconSvg;
      if (isCert) iconSvg = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>';
      else if (evt.event && (evt.event.toLowerCase().includes('diagnostic') || evt.event.toLowerCase().includes('inspection')))
        iconSvg = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>';
      else if (evt.event && (evt.event.toLowerCase().includes('renovation') || evt.event.toLowerCase().includes('travaux')))
        iconSvg = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"/><line x1="8" y1="2" x2="8" y2="18"/><line x1="16" y1="6" x2="16" y2="22"/></svg>';
      else iconSvg = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>';
      let details = '';
      if (evt.details) {
        if (evt.details.level) details = 'Niveau : ' + evt.details.level;
        else if (evt.details.property_id) details = 'ID : ' + evt.details.property_id;
        else if (evt.details.score != null) details = 'Score : ' + evt.details.score;
      }
      div.innerHTML = '<div class="tli">' + iconSvg + '</div><div class="tld">' + d + '</div><div class="tle">' + (evt.event || 'Événement') + '</div>' + (details ? '<div class="tldet">' + details + '</div>' : '');
      tl.appendChild(div);
    });
  }

  /* Twin chips */
  const zones = data.risk_summary && data.risk_summary.zones ? data.risk_summary.zones : {};
  const twinChips = pid_$('pid-twin-chips');
  twinChips.innerHTML = '';
  if (Object.keys(zones).length > 0) {
    Object.entries(zones).forEach(([key, val]) => {
      const score = val.score != null ? val.score : 0;
      const level = score <= 25 ? 'faible' : score <= 50 ? 'modere' : score <= 75 ? 'eleve' : 'critique';
      const chip = document.createElement('span');
      chip.className = 'tchip ' + level;
      chip.innerHTML = '<span class="cd"></span> ' + key.replace(/_/g, ' ');
      twinChips.appendChild(chip);
    });
  } else {
    twinChips.innerHTML = '<span style="color:var(--muted);font-size:12px;">Aucune zone de risque disponible</span>';
  }
  pid_$('pid-json-content').textContent = JSON.stringify(data, null, 2);

  /* Fade in */
  pid_fadeIn();

  /* Status */
  pid_setStatus('Property ID ' + (data.property_id || '') + ' — toutes les données ont été chargées avec succès.');
}

function pid_setStatus(msg, kind) {
  const dot = pid_$('pid-status-dot');
  const msgEl = pid_$('pid-status-msg');
  if (!dot || !msgEl) return;
  msgEl.textContent = msg;
  msgEl.className = 'msg' + (kind ? ' ' + kind : '');
  dot.className = 'dot' + (kind ? ' ' + kind : '');
}

function pid_applyDevisOverrides(currentAddress) {
  const devisSection = pid_$('pid-devis-result');
  if (!devisSection) return;
  devisSection.style.display = 'none';

  let stored;
  try {
    const raw = localStorage.getItem('typhoon_devis_result');
    if (!raw) return;
    stored = JSON.parse(raw);
    if (!stored || !stored.certifie) return;
  } catch (e) { return; }

  if (currentAddress && stored.adresse && currentAddress.toLowerCase() !== stored.adresse.toLowerCase()) return;

  devisSection.style.display = 'flex';
  devisSection.classList.remove('vis');
  requestAnimationFrame(() => devisSection.classList.add('vis'));

  pid_$('pid-dev-before').textContent = stored.score_avant;
  pid_$('pid-dev-after').textContent = stored.score_apres;
  pid_$('pid-dev-prime').textContent = stored.prime_percent + '%';
  pid_$('pid-dev-date').textContent = stored.date_generation ? new Date(stored.date_generation).toLocaleDateString('fr-FR') : '—';

  const ul = pid_$('pid-works-ul');
  ul.innerHTML = '';
  if (stored.travaux_retenus && stored.travaux_retenus.length) {
    stored.travaux_retenus.forEach(t => {
      const li = document.createElement('li');
      li.innerHTML = '<span><span class="wn">' + t.travaux + '</span><span class="wz"> — ' + (t.zone ? t.zone.replace(/_/g, ' ') : '') + '</span></span><span class="wc">' + (t.cout_estime || '—') + '</span>';
      ul.appendChild(li);
    });
  }

  const scoreBig = pid_$('pid-cert-score');
  if (scoreBig) scoreBig.innerHTML = stored.score_apres + '<sup style="font-size:12px;color:var(--success);"> ✓</sup>';

  const gaugeLabel = pid_$('pid-gauge-ov-explain');
  if (gaugeLabel) {
    gaugeLabel.innerHTML = 'Score après travaux réalisés <span style="color:var(--success);font-weight:600;">(−' + Math.round((1 - stored.score_apres / stored.score_avant) * 100) + '%)</span>';
  }
}

/* ===== ENTRY POINT — Construit les données depuis la mémoire SPA et affiche le Property ID ===== */
function pid_showPropertyID() {
  const screen = pid_$('property-id-screen');
  if (!screen) return;

  // --- Lire les données depuis les variables en mémoire de la SPA ---
  // Note : currentZones est une variable locale (let), pas window.currentZones
  const zones = (typeof currentZones !== 'undefined' && currentZones) ? currentZones : {};
  const overallScore = (typeof window.currentGlobalScore !== 'undefined' && window.currentGlobalScore != null)
    ? window.currentGlobalScore
    : (rawData ? rawData.score_global : 0) || 0;

  // --- Construire les recommandations depuis les zones ---
  const recos = [];
  Object.entries(zones).forEach(([zoneName, zoneData]) => {
    const zoneRecos = zoneData.recommandations || [];
    zoneRecos.forEach(r => {
      if (typeof r === 'object') { r.zone = zoneName; recos.push(r); }
    });
  });

  // --- Trouver la zone la plus risquée (champ = risque, pas score) ---
  let highestZone = null;
  let highestScore = -1;
  Object.entries(zones).forEach(([zoneName, zoneData]) => {
    const sc = zoneData.risque || zoneData.score || 0;
    if (sc > highestScore) { highestScore = sc; highestZone = zoneName; }
  });

  const riskZoneData = highestZone ? (zones[highestZone] || {}) : {};

  // --- Score Climat 2050 (chemin correct : rawData.projection_2050.score_global) ---
  const climateScore = (rawData && rawData.projection_2050 && rawData.projection_2050.score_global) || 0;

  // --- Adresse ---
  const addr = (rawData && rawData.adresse)
    ? rawData.adresse
    : (document.getElementById('f-adresse') ? document.getElementById('f-adresse').value : '—');

  // --- Building info : les données sont dans rawData.bien + rawData.geometry, pas rawData.building ---
  const bien = (rawData && rawData.bien) || {};
  const geometry = (rawData && rawData.geometry) || {};

  // Formater la toiture (éviter le "(None)")
  let roofStr = null;
  if (geometry.roof_shape) {
    roofStr = geometry.roof_shape;
    if (geometry.materiau_toiture) roofStr += ' (' + geometry.materiau_toiture + ')';
  }

  // --- Certification ---
  const certLevel = pid_certLevel(overallScore);

  const data = {
    property_id: 'TY-' + new Date().getFullYear() + '-' + String(Math.floor(Math.random() * 999999)).padStart(6, '0'),
    generated_at: new Date().toISOString(),
    building: {
      address: addr,
      construction_year: bien.annee_construction || null,
      building_type: bien.type || null,
      materials: geometry.materiau_mur || null,
      floors: geometry.floors_count || null,
      roof: roofStr,
    },
    certification: {
      level: certLevel !== '—' ? certLevel : null,
      score: overallScore,
      issued_at: new Date().toISOString(),
      expires_at: new Date(Date.now() + 365 * 24 * 60 * 60 * 1000).toISOString(),
    },
    scores: {
      overall: overallScore,
      climate: climateScore,
      insurance: overallScore,
      zones: zones,
    },
    risk_summary: {
      highest_risk: highestZone ? highestZone.replace(/_/g, ' ') : '—',
      risk_level: riskZoneData.niveau || 'N/A',
      main_hazard: riskZoneData.alea_principal || 'N/A',
      zones: zones,
    },
    recommendations: recos,
    timeline: [
      { date: new Date().toISOString(), event: 'Property ID généré', details: { score: overallScore } },
    ],
    contract: { zones: zones },
  };

  // Afficher l'écran
  screen.style.display = 'block';
  document.body.style.overflow = 'hidden'; // Empêcher le scroll du fond

  // Rendre le Property ID
  pid_renderPropertyID(data);

  // Appliquer les overrides du devis si présents
  pid_applyDevisOverrides(addr);

  pid_setStatus('Property ID affiché avec succès.');
}

/* Fermer le Property ID */
var pidCloseBtn = pid_$('pid-close-btn');
if (pidCloseBtn) {
  pidCloseBtn.addEventListener('click', function() {
    pid_$('property-id-screen').style.display = 'none';
    document.body.style.overflow = '';
  });
}

/* JSON toggle */
var pidJsonBtn = pid_$('pid-json-btn');
if (pidJsonBtn) {
  pidJsonBtn.addEventListener('click', function() {
    var block = pid_$('pid-json-block');
    if (block) {
      var open = block.classList.toggle('open');
      this.textContent = open ? 'Masquer le JSON brut' : 'Afficher le JSON brut';
    }
  });
}

/* Ajouter un gestionnaire pour le lien nav vers Property ID */
document.querySelectorAll('#home-nav a').forEach(function(a) {
  if (a.textContent.trim() === 'Property ID') {
    a.addEventListener('click', function(e) {
      e.preventDefault();
      if (typeof window.currentGlobalScore !== 'undefined' && window.currentGlobalScore !== null) {
        pid_showPropertyID();
      } else {
        var navEmpty = pid_$('property-id-screen');
        if (navEmpty) {
          navEmpty.style.display = 'block';
          document.body.style.overflow = 'hidden';
          pid_$('pid-prop-address').textContent = 'Aucun diagnostic disponible';
          pid_$('pid-cert-level').textContent = 'Aucune donnée';
          pid_$('pid-cert-level').className = 'cl pending';
          pid_$('pid-cert-desc').textContent = 'Lancez un diagnostic depuis la page d\'accueil Typhoon pour générer un Property ID.';
          pid_$('pid-cert-explain').textContent = '';
          pid_$('pid-verif-badge').style.display = 'none';
          pid_$('pid-cert-score').textContent = '—';
          pid_$('pid-cert-pill').style.display = 'none';
          pid_$('pid-reco-list').innerHTML = '<div class="pid-reco-empty"><p style="font-size:13px">Lancez un diagnostic pour voir les recommandations.</p></div>';
          pid_$('pid-timeline-container').innerHTML = '<div class="pid-reco-empty"><p style="font-size:13px">Aucun historique disponible.</p></div>';
          pid_$('pid-twin-chips').innerHTML = '<span style="color:var(--muted);font-size:12px;">Aucune donnée de jumeau numérique disponible.</span>';
          pid_setStatus('Aucune adresse trouvée. Veuillez d\'abord lancer un diagnostic.', null);
          pid_fadeIn();
        }
      }
    });
  }
});

</script>
</body>
</html>
